+// Size in the SPIR-V storage layout, rather than sizeof(the thread-local value).
+uint64_t CompilerMSL::robust_buffer_access_size(uint32_t type_id, const SPIRType &type, uint32_t matrix_stride,
+                                               bool row_major, uint32_t component_stride) const
+{
+	if (!type.array.empty())
+	{
+		uint32_t count = type.array_size_literal.back() ? type.array.back() : evaluate_constant_u32(type.array.back());
+		return uint64_t(get_decoration(type_id, DecorationArrayStride)) * count;
+	}
+	if (type.basetype == SPIRType::Struct)
+		return get_declared_struct_size(type);
+	uint64_t scalar_size = type.width / 8;
+	if (type.columns > 1)
+	{
+		uint64_t major_count = row_major ? type.vecsize : type.columns;
+		uint64_t minor_count = row_major ? type.columns : type.vecsize;
+		return (major_count - 1) * matrix_stride + minor_count * scalar_size;
+	}
+	return (type.vecsize - 1) * (component_stride ? component_stride : scalar_size) + scalar_size;
+}
+
+// Loads in loops may reuse a hoisted temporary. Reset it for every execution,
+// including the out-of-range iteration after an earlier in-range iteration.
+void CompilerMSL::emit_robust_buffer_zero(uint32_t type_id, const string &expression, uint32_t depth)
+{
+	auto &type = get<SPIRType>(type_id);
+	if (!type.array.empty())
+	{
+		auto count = type.array_size_literal.back() ? convert_to_string(type.array.back()) : to_expression(type.array.back());
+		auto index = join("spvRobustZeroIndex", depth);
+		statement("for (uint ", index, " = 0; ", index, " < ", count, "; ++", index, ")");
+		begin_scope();
+		emit_robust_buffer_zero(type.parent_type, join(expression, "[", index, "]"), depth + 1);
+		end_scope();
+	}
+	else
+		statement(expression, " = {};");
+}
+
+void CompilerMSL::emit_robust_buffer_access_chain(const uint32_t *ops, uint32_t length, bool pointer_access)
+{
+	auto *var = maybe_get_backing_variable(ops[2]);
+	auto *result = maybe_get<SPIRExpression>(ops[1]);
+	if (!var || !result || (var->storage != StorageClassStorageBuffer &&
+	    !(var->storage == StorageClassUniform &&
+	      (has_decoration(get_variable_data_type(*var).self, DecorationBufferBlock) ||
+	       has_decoration(get_variable_data_type(*var).self, DecorationBlock)))))
+		return;
+	// Descriptor arrays have a separate descriptor index and require their selected
+	// size expression, not the containing variable's size. Keep the existing path.
+	if (!get_variable_data_type(*var).array.empty())
+		return;
+	auto *base = maybe_get<SPIRExpression>(ops[2]);
+	string offset = base && !base->robust_buffer_byte_offset.empty() ? base->robust_buffer_byte_offset : "0ul";
+	string indices = base ? base->robust_buffer_index_condition : string();
+	uint32_t matrix_stride = base ? base->robust_buffer_matrix_stride : 0;
+	uint32_t component_stride = base ? base->robust_buffer_component_stride : 0;
+	bool row_major = base && base->robust_buffer_row_major;
+	uint32_t type_id = get_pointee_type_id(expression_type_id(ops[2]));
+	const SPIRType *type = &get<SPIRType>(type_id);
+	auto append_condition = [&](const string &condition) {
+		indices = indices.empty() ? condition : join("(", indices, " && ", condition, ")");
+	};
+	auto size = to_buffer_size_expression(var->self);
+	uint32_t first_index = 3;
+	if (pointer_access)
+	{
+		// OpPtrAccessChain's Element operand advances by whole pointee objects
+		// before its ordinary member/array indices. Bound before multiplying.
+		if (length < 4)
+			return;
+		uint32_t element_stride = get_decoration(expression_type_id(ops[2]), DecorationArrayStride);
+		if (!element_stride)
+			return;
+		auto element = join("ulong(", to_expression(ops[3]), ")");
+		append_condition(join("(", element, " <= ulong(", size, ") / ", element_stride, "ul)"));
+		offset = join("(", offset, " + ", element, " * ", element_stride, "ul)");
+		first_index = 4;
+	}
+	for (uint32_t i = first_index; i < length; i++)
+	{
+		uint32_t index_id = ops[i];
+		if (!type->array.empty())
+		{
+			uint32_t stride = get_decoration(type_id, DecorationArrayStride);
+			if (!stride)
+				return;
+			auto index = join("ulong(", to_expression(index_id), ")");
+			// Check before multiplying, so an invalid large/negative index cannot wrap.
+			append_condition(join("(", index, " <= ulong(", size, ") / ", stride, "ul)"));
+			if (type->op != OpTypeRuntimeArray)
+			{
+				auto count = type->array_size_literal.back() ? convert_to_string(type->array.back()) : to_expression(type->array.back());
+				append_condition(join("(", index, " < ulong(", count, "))"));
+			}
+			offset = join("(", offset, " + ", index, " * ", stride, "ul)");
+			type_id = type->parent_type;
+			type = &get<SPIRType>(type_id);
+		}
+		else if (type->basetype == SPIRType::Struct)
+		{
+			auto *member = maybe_get<SPIRConstant>(index_id);
+			if (!member || member->scalar() >= type->member_types.size())
+				return;
+			uint32_t index = member->scalar();
+			offset = join("(", offset, " + ", get_member_decoration(type->self, index, DecorationOffset), "ul)");
+			matrix_stride = get_member_decoration(type->self, index, DecorationMatrixStride);
+			row_major = has_member_decoration(type->self, index, DecorationRowMajor);
+			component_stride = 0;
+			type_id = type->member_types[index];
+			type = &get<SPIRType>(type_id);
+		}
+		else if (type->columns > 1)
+		{
+			auto index = join("ulong(", to_expression(index_id), ")");
+			append_condition(join("(", index, " < ", type->columns, "ul)"));
+			uint32_t stride = row_major ? type->width / 8 : matrix_stride;
+			component_stride = row_major ? matrix_stride : type->width / 8;
+			offset = join("(", offset, " + ", index, " * ", stride, "ul)");
+			type_id = type->parent_type;
+			type = &get<SPIRType>(type_id);
+		}
+		else if (type->vecsize > 1)
+		{
+			auto index = join("ulong(", to_expression(index_id), ")");
+			append_condition(join("(", index, " < ", type->vecsize, "ul)"));
+			offset = join("(", offset, " + ", index, " * ", component_stride ? component_stride : type->width / 8, "ul)");
+			type_id = type->parent_type;
+			type = &get<SPIRType>(type_id);
+			component_stride = 0;
+		}
+		else
+			return;
+	}
+	uint64_t access_size = robust_buffer_access_size(type_id, *type, matrix_stride, row_major, component_stride);
+	if (!access_size)
+		return;
+	result->robust_buffer_byte_offset = offset;
+	result->robust_buffer_index_condition = indices;
+	result->robust_buffer_matrix_stride = matrix_stride;
+	result->robust_buffer_component_stride = component_stride;
+	result->robust_buffer_row_major = row_major;
+	auto range = join("(ulong(", size, ") >= ", access_size, "ul && ", offset,
+	                  " <= ulong(", size, ") - ", access_size, "ul)");
+	result->robust_buffer_access_condition = indices.empty() ? range : join("(", indices, " && ", range, ")");
+}
