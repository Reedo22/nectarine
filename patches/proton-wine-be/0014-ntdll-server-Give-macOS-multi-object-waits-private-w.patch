- * the shm. Wakers only enter the kernel when the matching bucket is non-zero; collisions
- * merely cost a redundant wake. */
-#define MAC_SYNC_BUCKETS 1024
-#define MAC_BUCKET(addr) ((((uintptr_t)(addr)) & 0xfff) >> 2)
-static int *mac_sync_base;
-#define MAC_GEN              (&mac_sync_base[0])
-#define MAC_SLEEPERS(addr)   (&mac_sync_base[4 + MAC_BUCKET(addr)])
-#define MAC_WATCHERS(addr)   (&mac_sync_base[4 + MAC_SYNC_BUCKETS + MAC_BUCKET(addr)])
+/* See wine/fsync_mac.h for the wait bookkeeping shared with the server. */
+static struct mac_sync_shm *mac_sync;
 
 static int mac_wait_on_address( int *addr, int val, const struct timespec64 *end, clockid_t clock_id )
 {
@@ -198,12 +183,9 @@ static int mac_first_changed( const struct futex_waitv *futexes, int count )
     return -1;
 }
 
-static void mac_watch( const struct futex_waitv *futexes, int count, int delta )
+static inline unsigned int futex_bucket( const struct futex_waitv *futex )
 {
-    int i;
-
-    for (i = 0; i < count; i++)
-        __atomic_add_fetch( MAC_WATCHERS(u64_to_ptr(futexes[i].uaddr)), delta, __ATOMIC_SEQ_CST );
+    return mac_sync_bucket( u64_to_ptr(futex->uaddr) );
 }
 
 /* Same contract as futex_waitv: -1/EAGAIN if a value already differs, -1/ETIMEDOUT on
@@ -211,24 +193,50 @@ static void mac_watch( const struct futex_waitv *futexes, int count, int delta )
 static inline int futex_wait_multiple( const struct futex_waitv *futexes,
         int count, const struct timespec64 *end, clockid_t clock_id )
 {
-    int ret, gen;
+    int ret, i, slot = -1, added = 0;
 
     if (count == 1)
     {
         int *addr = u64_to_ptr(futexes[0].uaddr);
+        int *sleepers = &mac_sync->sleepers[mac_sync_bucket( addr )];
 
-        __atomic_add_fetch( MAC_SLEEPERS(addr), 1, __ATOMIC_SEQ_CST );
+        __atomic_add_fetch( sleepers, 1, __ATOMIC_SEQ_CST );
         if (mac_first_changed( futexes, 1 ) == 0) ret = 0;
         else ret = mac_wait_on_address( addr, futexes[0].val, end, clock_id );
-        __atomic_sub_fetch( MAC_SLEEPERS(addr), 1, __ATOMIC_SEQ_CST );
+        __atomic_sub_fetch( sleepers, 1, __ATOMIC_SEQ_CST );
     }
     else
     {
-        mac_watch( futexes, count, 1 );
-        gen = __atomic_load_n( MAC_GEN, __ATOMIC_SEQ_CST );
-        if (mac_first_changed( futexes, count ) >= 0) ret = 0;
-        else ret = mac_wait_on_address( MAC_GEN, gen, end, clock_id );
-        mac_watch( futexes, count, -1 );
+        /* Sleep on a private wake word that wakers of any watched address set. */
+        if ((slot = mac_sync_alloc_slot( mac_sync, GetCurrentThreadId() )) >= 0)
+        {
+            __atomic_store_n( &mac_sync->words[slot], 0, __ATOMIC_SEQ_CST );
+            for (added = 0; added < count; added++)
+                if (!mac_sync_list_add( mac_sync, futex_bucket( &futexes[added] ), slot + 1 )) break;
+        }
+        if (slot >= 0 && added == count)
+        {
+            if (mac_first_changed( futexes, count ) >= 0) ret = 0;
+            else ret = mac_wait_on_address( &mac_sync->words[slot], 0, end, clock_id );
+        }
+        else
+        {
+            /* No free slot or a full bucket list: use the shared wake generation. */
+            int gen;
+
+            for (i = 0; i < count; i++)
+                __atomic_add_fetch( &mac_sync->overflow[futex_bucket( &futexes[i] )], 1, __ATOMIC_SEQ_CST );
+            gen = __atomic_load_n( &mac_sync->gen, __ATOMIC_SEQ_CST );
+            if (mac_first_changed( futexes, count ) >= 0) ret = 0;
+            else ret = mac_wait_on_address( &mac_sync->gen, gen, end, clock_id );
+            for (i = 0; i < count; i++)
