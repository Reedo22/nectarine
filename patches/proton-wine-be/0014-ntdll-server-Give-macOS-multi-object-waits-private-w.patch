+        }
+        if (slot >= 0)
+        {
+            for (i = 0; i < added; i++) mac_sync_list_remove( mac_sync, futex_bucket( &futexes[i] ), slot + 1 );
+            mac_sync_free_slot( mac_sync, slot );
+        }
     }
     if (ret < 0 && errno == ETIMEDOUT) return -1;
     if ((ret = mac_first_changed( futexes, count )) >= 0) return ret;
@@ -252,16 +260,7 @@ static inline int futex_wait_multiple( const struct futex_waitv *futexes,
 static inline int futex_wake( int *addr, int val )
 {
 #ifdef __APPLE__
