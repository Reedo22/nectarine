diff --git a/include/wine/fsync_mac.h b/include/wine/fsync_mac.h
new file mode 100644
index 00000000000..dc3a45c4a78
--- /dev/null
+++ b/include/wine/fsync_mac.h
@@ -0,0 +1,152 @@
+/*
+ * macOS wait/wake layer for the fsync in-process sync backend
+ *
+ * Copyright 2026 Nectarine contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINE_FSYNC_MAC_H
+#define __WINE_FSYNC_MAC_H
+
+#ifdef __APPLE__
+
+#include <stdint.h>
+#include <os/os_sync_wait_on_address.h>
+
+/* macOS has os_sync_wait_on_address (a futex that works across processes on shared
+ * mappings, 14.4+) but nothing like futex_waitv. Both the clients and the server keep
+ * this bookkeeping at the start of the fsync shm, which the server never hands out:
+ *
+ *   gen                 wake generation, fallback for multi-address waits
+ *   sleepers[b]         threads sleeping directly on an address in bucket b
+ *   overflow[b]         fallback multi-address waiters watching bucket b
+ *   slot_map            allocation bitmap for per-wait wake words
+ *   words[s]            wake word of multi-address wait s (0 = sleeping, 1 = woken)
+ *   lists[b][k]         s + 1 for multi-address waits watching bucket b, 0 = empty
+ *
+ * Buckets are keyed by the offset within a 4 KiB page, which is the same in every process
+ * that maps the shm (even with Rosetta's 4 KiB pages). Wakers only enter the kernel for
+ * buckets that have someone in them; collisions just cost a redundant wake, and every
+ * waiter re-checks its objects after waking.
+ *
+ * Ordering: a waker stores the new value, then (full fence) reads the bucket; a waiter
+ * registers in the bucket with a full-barrier atomic, then reads the value (or lets the
+ * kernel compare it). So either the waiter sees the new value or the waker sees it. */
+
+#define MAC_SYNC_BUCKETS    1024
+#define MAC_SYNC_LIST_LEN   8
+#define MAC_SYNC_SLOTS      4096
+
+struct mac_sync_shm
+{
+    int      gen;
+    int      pad[3];
+    int      sleepers[MAC_SYNC_BUCKETS];
+    int      overflow[MAC_SYNC_BUCKETS];
+    uint64_t slot_map[MAC_SYNC_SLOTS / 64];
+    int      words[MAC_SYNC_SLOTS];
+    int      lists[MAC_SYNC_BUCKETS][MAC_SYNC_LIST_LEN];
+};
+
+/* first fsync shm index (16 bytes each) not covered by struct mac_sync_shm */
+#define MAC_SYNC_RESERVED_IDX ((sizeof(struct mac_sync_shm) + 15) / 16)
+
+static inline unsigned int mac_sync_bucket( const void *addr )
+{
+    return (((uintptr_t)addr) & 0xfff) >> 2;
+}
+
+static inline void mac_sync_wake_addr( int *addr )
+{
+    os_sync_wake_by_address_all( addr, sizeof(*addr), OS_SYNC_WAKE_BY_ADDRESS_SHARED );
+}
+
+/* Wake everything waiting for *addr to change. Call after storing the new value. */
+static inline void mac_sync_wake( struct mac_sync_shm *shm, int *addr )
+{
+    unsigned int b = mac_sync_bucket( addr ), k;
+
+    __atomic_thread_fence( __ATOMIC_SEQ_CST );
+    if (__atomic_load_n( &shm->sleepers[b], __ATOMIC_SEQ_CST )) mac_sync_wake_addr( addr );
+    for (k = 0; k < MAC_SYNC_LIST_LEN; k++)
+    {
+        int entry = __atomic_load_n( &shm->lists[b][k], __ATOMIC_SEQ_CST );
+        if (!entry) continue;
+        __atomic_store_n( &shm->words[entry - 1], 1, __ATOMIC_SEQ_CST );
+        mac_sync_wake_addr( &shm->words[entry - 1] );
+    }
+    if (__atomic_load_n( &shm->overflow[b], __ATOMIC_SEQ_CST ))
+    {
+        __atomic_add_fetch( &shm->gen, 1, __ATOMIC_SEQ_CST );
+        mac_sync_wake_addr( &shm->gen );
+    }
+}
+
+static inline int mac_sync_alloc_slot( struct mac_sync_shm *shm, unsigned int hint )
+{
+    unsigned int i, w;
+
+    for (i = 0; i < MAC_SYNC_SLOTS / 64; i++)
+    {
+        uint64_t *word = &shm->slot_map[w = (hint + i) % (MAC_SYNC_SLOTS / 64)];
+        uint64_t cur = __atomic_load_n( word, __ATOMIC_SEQ_CST );
+
+        while (~cur)
+        {
+            unsigned int bit = __builtin_ctzll( ~cur );
+            if (__atomic_compare_exchange_n( word, &cur, cur | ((uint64_t)1 << bit), 0,
+                                             __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST ))
+                return w * 64 + bit;
+        }
+    }
+    return -1;
+}
+
+static inline void mac_sync_free_slot( struct mac_sync_shm *shm, int slot )
+{
+    __atomic_and_fetch( &shm->slot_map[slot / 64], ~((uint64_t)1 << (slot % 64)), __ATOMIC_SEQ_CST );
+}
+
+static inline int mac_sync_list_add( struct mac_sync_shm *shm, unsigned int b, int entry )
+{
+    unsigned int k;
+
+    for (k = 0; k < MAC_SYNC_LIST_LEN; k++)
+    {
+        int empty = 0;
+        if (__atomic_compare_exchange_n( &shm->lists[b][k], &empty, entry, 0,
+                                         __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST ))
+            return 1;
+    }
+    return 0;
+}
+
+static inline void mac_sync_list_remove( struct mac_sync_shm *shm, unsigned int b, int entry )
+{
+    unsigned int k;
+
+    for (k = 0; k < MAC_SYNC_LIST_LEN; k++)
+    {
+        int expected = entry;
+        if (__atomic_compare_exchange_n( &shm->lists[b][k], &expected, 0, 0,
+                                         __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST ))
+            return;
+    }
+}
+
+#endif /* __APPLE__ */
+
+#endif /* __WINE_FSYNC_MAC_H */
