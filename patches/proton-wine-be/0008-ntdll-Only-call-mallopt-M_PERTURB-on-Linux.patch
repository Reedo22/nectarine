From 4cf3a347a233c0952a7774ce77e0298ebd428d62 Mon Sep 17 00:00:00 2001
From: Nectarine <nectarine@localhost>
Date: Sat, 24 Oct 2026 13:03:02 -0400
Subject: [PATCH 08/29] ntdll: Only call mallopt(M_PERTURB) on Linux.

It is a glibc extension.
---
 dlls/ntdll/unix/loader.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index 552c8b82195..2361c0df6ae 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -2423,7 +2423,9 @@ static void start_main_thread(void)
     set_thread_teb( teb );
 #endif
 
+#ifdef __linux__
     mallopt( M_PERTURB, 0xff );
+#endif
     init_startup_info();
     *(ULONG_PTR *)&peb->CloudFileFlags = get_image_address();
     set_load_order_app_name( main_wargv[0] );
@@ -2432,7 +2434,9 @@ static void start_main_thread(void)
     load_ntdll();
     load_wow64_ntdll( main_image_info.Machine );
     load_apiset_dll();
+#ifdef __linux__
     mallopt( M_PERTURB, 0 );
+#endif
     server_init_process_done();
 }
 
