From 65b3685d08b36ae834076bcc5d8c8368088fa361 Mon Sep 17 00:00:00 2001
From: Nectarine <nectarine@localhost>
Date: Sat, 24 Oct 2026 12:51:18 -0400
Subject: [PATCH 02/29] ntdll: Make the early set_thread_teb() hack Linux-only.

On macOS %gs holds the pthread TSD base and Wine swaps it on syscall
entry (mac_thread_gsbase); upstream never points it at the TEB.
---
 dlls/ntdll/unix/signal_x86_64.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
index 751d955c564..931ed837395 100644
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -3098,7 +3098,9 @@ void signal_init_process(void)
 
 void set_thread_teb( TEB *teb )
 {
+#ifdef __linux__
     arch_prctl( ARCH_SET_GS, teb );
+#endif
 }
 
