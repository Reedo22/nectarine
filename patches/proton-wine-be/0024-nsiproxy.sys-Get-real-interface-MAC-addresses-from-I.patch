+
+#if 0
+#pragma makedep unix
+#endif
+
+#ifdef __APPLE__
+
+#include <string.h>
+#include <CoreFoundation/CoreFoundation.h>
+#include <IOKit/IOKitLib.h>
+#include <IOKit/network/IOEthernetInterface.h>
+#include <IOKit/network/IOEthernetController.h>
+
+/* macOS hands processes without a privileged identity a placeholder link-layer address
+ * (02:00:00:00:00:00) from sysctl/getifaddrs. IOKit still reports the real one; look it up
+ * by BSD interface name. Returns 1 on success. */
+int ndis_mac_get_hw_address( const char *bsd_name, unsigned char *addr, unsigned int len )
+{
+    io_iterator_t iter;
+    io_object_t intf;
+    int found = 0;
+
+    if (IOServiceGetMatchingServices( kIOMainPortDefault, IOServiceMatching( kIOEthernetInterfaceClass ), &iter ))
+        return 0;
+
+    while (!found && (intf = IOIteratorNext( iter )))
+    {
+        char name[64];
+        CFStringRef bsd = IORegistryEntryCreateCFProperty( intf, CFSTR( kIOBSDNameKey ), kCFAllocatorDefault, 0 );
+
+        if (bsd && CFStringGetCString( bsd, name, sizeof(name), kCFStringEncodingUTF8 ) && !strcmp( name, bsd_name ))
+        {
+            io_object_t controller;
+
+            if (!IORegistryEntryGetParentEntry( intf, kIOServicePlane, &controller ))
+            {
+                CFDataRef mac = IORegistryEntryCreateCFProperty( controller, CFSTR( kIOMACAddress ), kCFAllocatorDefault, 0 );
+                if (mac)
+                {
+                    if (CFDataGetLength( mac ) == len)
+                    {
+                        memcpy( addr, CFDataGetBytePtr( mac ), len );
+                        found = 1;
+                    }
+                    CFRelease( mac );
+                }
+                IOObjectRelease( controller );
+            }
+        }
+        if (bsd) CFRelease( bsd );
+        IOObjectRelease( intf );
+    }
+    IOObjectRelease( iter );
+    return found;
+}
+
+#endif /* __APPLE__ */
