From 589e4f5045bf15473040339e1cf7289123806a1b Mon Sep 17 00:00:00 2001
From: Reedo22 <141674188+Reedo22@users.noreply.github.com>
Date: Mon, 26 Oct 2026 21:55:53 -0400
Subject: [PATCH 2/2] win32u: Draw into other-process windows through
 shared-memory surfaces.

Chromium's software compositor (current Steam client, CEF 126) runs in the
GPU process and presents with GetDC + BitBlt on the browser process's HWND.
winemac cannot reach another process's window surface, so every frame was
lost and Steam's window stayed black. Give such DCs a shared-memory surface
sized to the drawn window and have the owner copy the dirty bits into its
own window on ReleaseDC (WM_WINE_FLUSHSHMSURFACE).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dlls/win32u/dce.c | 75 ++++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 74 insertions(+), 1 deletion(-)

diff --git a/dlls/win32u/dce.c b/dlls/win32u/dce.c
index cc97af7a0d9..cbd62993850 100644
--- a/dlls/win32u/dce.c
+++ b/dlls/win32u/dce.c
@@ -915,6 +915,70 @@ struct window_surface *create_shm_surface( HWND window, HWND parent, const RECT
     return &surface->header;
 }
 
+/* GDI drawing into a window that belongs to another process, e.g. Chromium's software
+ * compositor in its GPU process presenting into the browser's HWND with GetDC + BitBlt.
+ * This process cannot reach the owner's window surface, so the drawing would be lost:
+ * draw into a shared-memory surface instead and let the owner copy the dirty bits into
+ * its own window (WM_WINE_FLUSHSHMSURFACE). */
+struct foreign_surface
+{
+    struct list entry;
+    HWND hwnd;
+    struct window_surface *surface;
+};
+
+static struct list foreign_surfaces = LIST_INIT( foreign_surfaces );
+static pthread_mutex_t foreign_surfaces_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static struct foreign_surface *find_foreign_surface( HWND hwnd )
+{
+    struct foreign_surface *entry;
+
+    LIST_FOR_EACH_ENTRY( entry, &foreign_surfaces, struct foreign_surface, entry )
+        if (entry->hwnd == hwnd) return entry;
+    return NULL;
+}
+
+static struct window_surface *get_foreign_surface( HWND hwnd, const RECT *window_rect )
+{
+    struct foreign_surface *entry;
+    struct window_surface *surface;
+
+    pthread_mutex_lock( &foreign_surfaces_lock );
+    entry = find_foreign_surface( hwnd );
+    if ((surface = create_shm_surface( hwnd, hwnd, window_rect, entry ? entry->surface : NULL )))
+    {
+        if (!entry && (entry = calloc( 1, sizeof(*entry) )))
+        {
+            entry->hwnd = hwnd;
+            list_add_head( &foreign_surfaces, &entry->entry );
+        }
+        else if (entry) window_surface_release( entry->surface );
+        if (entry)
+        {
+            entry->surface = surface;
+            window_surface_add_ref( surface );
+        }
+        TRACE( "hwnd %p rect %s -> %p\n", hwnd, wine_dbgstr_rect( window_rect ), surface );
+    }
+    pthread_mutex_unlock( &foreign_surfaces_lock );
+    return surface;
+}
+
+static void flush_foreign_surface( HWND hwnd )
+{
+    struct foreign_surface *entry;
+    struct window_surface *surface = NULL;
+
+    pthread_mutex_lock( &foreign_surfaces_lock );
+    if ((entry = find_foreign_surface( hwnd )))
+        window_surface_add_ref( (surface = entry->surface) );
+    pthread_mutex_unlock( &foreign_surfaces_lock );
+    if (!surface) return;
+    window_surface_flush( surface );
+    window_surface_release( surface );
+}
+
 void process_surface_message( struct flush_shm_surface_params *params )
 {
     HANDLE mapping = LongToHandle( params->section );
@@ -1104,7 +1168,12 @@ static void update_visible_region( struct dce *dce )
         || force_present_to_surface( &win_rect ))
     {
         win = get_win_ptr( top_win );
-        if (win && win != WND_DESKTOP && win != WND_OTHER_PROCESS)
+        if (win == WND_OTHER_PROCESS && !is_current_process_window( dce->hwnd ))
+        {
+            /* surface coordinates are the drawn window's own */
+            if ((surface = get_foreign_surface( dce->hwnd, &win_rect ))) top_rect = win_rect;
+        }
+        else if (win && win != WND_DESKTOP && win != WND_OTHER_PROCESS)
         {
             surface = win->surface;
             if (surface) window_surface_add_ref( surface );
@@ -1482,6 +1551,7 @@ void invalidate_dce( WND *win, const RECT *old_rect )
 static INT release_dc( HWND hwnd, HDC hdc, BOOL end_paint )
 {
     struct list drawables = LIST_INIT( drawables );
+    HWND drawn = 0;
     struct dce *dce;
     BOOL ret = FALSE;
 
@@ -1491,6 +1561,7 @@ static INT release_dc( HWND hwnd, HDC hdc, BOOL end_paint )
     dce = get_dc_dce( hdc );
     if (dce && dce->count && dce->hwnd)
     {
+        drawn = dce->hwnd;
         if (!(dce->flags & DCX_NORESETATTRS)) set_dce_flags( dce->hdc, DCHF_RESETDC );
         if (end_paint || (dce->flags & DCX_CACHE)) delete_clip_rgn( dce );
         if (dce->flags & DCX_CACHE)
@@ -1504,6 +1575,8 @@ static INT release_dc( HWND hwnd, HDC hdc, BOOL end_paint )
     user_unlock();
 
     release_opengl_drawables( &drawables );
+    /* sends a message to the owner, so never under the user lock */
+    if (drawn) flush_foreign_surface( drawn );
     return ret;
 }
 
