+/* Nectarine: a GPU process (Chromium/CEF) presenting to a window owned by another process.
+ * The renderer exports a CAMetalLayer through a CAContext; the window's owner hosts it with a
+ * CALayerHost sublayer (same mechanism CrossOver uses for its remote swapchains). */
+typedef uint32_t CGSConnectionID;
+extern CGSConnectionID CGSMainConnectionID(void);
+typedef uint32_t CAContextID;
+
+@interface CAContext : NSObject
++ (id) contextWithCGSConnection:(CGSConnectionID)connection options:(NSDictionary*)options;
+@property(readonly) CAContextID contextId;
+@property(retain) CALayer* layer;
+@end
+
+@interface CALayerHost : CALayer
+- (void) setContextId:(CAContextID)contextId;
+@end
+
+@interface NectarineRemoteMetal : NSObject
+{
+@public
+    CAContext *context;
+    CAMetalLayer *layer;
+    macdrv_metal_device device;
+}
+@end
+@implementation NectarineRemoteMetal
+@end
+
+void *macdrv_create_remote_metal_layer(CGRect bounds, unsigned int *context_id, macdrv_metal_layer *layer_out)
+{
+    __block NectarineRemoteMetal *r = [[NectarineRemoteMetal alloc] init];
+
+    r->device = macdrv_create_metal_device();
+    OnMainThread(^{
+        r->layer = [[CAMetalLayer alloc] init];
+        r->layer.device = (id<MTLDevice>)r->device;
+        r->layer.framebufferOnly = YES;
+        r->layer.magnificationFilter = kCAFilterNearest;
+        r->layer.backgroundColor = CGColorGetConstantColor(kCGColorBlack);
+        r->layer.contentsScale = retina_on ? 2.0 : 1.0;
+        r->layer.bounds = bounds;
+        r->layer.anchorPoint = CGPointMake(0, 0);
+        r->context = [[CAContext contextWithCGSConnection:CGSMainConnectionID() options:[NSDictionary dictionary]] retain];
+        [r->context setLayer:r->layer];
+    });
+    if (!r->context || ![r->context contextId])
+    {
+        macdrv_release_remote_metal_layer(r);
+        return NULL;
+    }
+    *context_id = [r->context contextId];
+    *layer_out = (macdrv_metal_layer)r->layer;
+    return r;
+}
+
+void macdrv_release_remote_metal_layer(void *remote)
+{
+    NectarineRemoteMetal *r = remote;
+    OnMainThreadAsync(^{
+        [r->context setLayer:nil];
+        [r->context release];
+        [r->layer release];
+        if (r->device) macdrv_release_metal_device(r->device);
+        [r release];
     });
 }
+
+static NSMutableDictionary *nectarine_layer_hosts;
+
+void macdrv_window_create_ca_layer_host_view(macdrv_window w, unsigned int context_id, CGRect frame)
+{
+    WineWindow *window = (WineWindow*)w;
+
+    OnMainThread(^{
+        CALayerHost *host;
+        NSView *view = window.contentView;
+
+        if (!nectarine_layer_hosts) nectarine_layer_hosts = [[NSMutableDictionary alloc] init];
+        [[nectarine_layer_hosts objectForKey:@(context_id)] removeFromSuperlayer];
+        host = [CALayerHost layer];
+        [host setContextId:context_id];
+        host.magnificationFilter = kCAFilterNearest;
+        host.contentsScale = retina_on ? 2.0 : 1.0;
+        host.frame = frame;
+        host.autoresizingMask = kCALayerWidthSizable | kCALayerHeightSizable;
+        [view.layer addSublayer:host];
+        [nectarine_layer_hosts setObject:host forKey:@(context_id)];
+        [window windowDidDrawContent];
+    });
+}
+
+void macdrv_window_release_ca_layer_host_view(macdrv_window w, unsigned int context_id)
+{
+    OnMainThread(^{
+        [[nectarine_layer_hosts objectForKey:@(context_id)] removeFromSuperlayer];
+        [nectarine_layer_hosts removeObjectForKey:@(context_id)];
+    });
+}
