Subject: [PATCH 13/19] ntdll, server: Add a macOS wait/wake layer for the
 fsync backend.

macOS has a cross-process futex (os_sync_wait_on_address, 14.4+) but no
futex_waitv. Single-address waits use it directly; multi-address waits sleep
on a wake generation in the reserved shm slot 0 that wakers bump only while
such waiters exist. The shm is sized once because XNU allows ftruncate() only
once. Enabled by WINEFSYNC=1 or WINEMSYNC=1.

This plays the role msync has on macOS, but plugs into Proton's existing fsync
object logic instead of replacing it.
---
 dlls/ntdll/unix/fsync.c | 113 +++++++++++++++++++++++++++++++++++-----
 server/fsync.c          |  41 +++++++++++++--
 2 files changed, 137 insertions(+), 17 deletions(-)

diff --git a/dlls/ntdll/unix/fsync.c b/dlls/ntdll/unix/fsync.c
index 0e19a08..eb45e0c 100644
--- a/dlls/ntdll/unix/fsync.c
+++ b/dlls/ntdll/unix/fsync.c
@@ -44,6 +44,10 @@
 #endif
 #include <unistd.h>
 #include <stdint.h>
+#ifdef __APPLE__
+# include <os/clock.h>
+# include <os/os_sync_wait_on_address.h>
+#endif
 
 #include "ntstatus.h"
 #define WIN32_NO_STATUS
@@ -138,27 +142,109 @@ static void simulate_sched_quantum(void)
     usleep(0);
 }
 
+#ifdef __APPLE__
+
+/* macOS has no futex_waitv. A wait on one address uses os_sync_wait_on_address (a
+ * cross-process futex on shared mappings). A wait on several addresses sleeps on a wake
+ * generation kept in the reserved shm slot 0, which every wake bumps while such waiters
+ * exist ([0] = generation, [1] = number of multi-address waiters). Callers re-check object
+ * state after any wake, so a wake that was meant for someone else only costs a loop. */
+static int *mac_wake_slot;
+#define MAC_WAKE_SLOT mac_wake_slot
+
+static int mac_wait_on_address( int *addr, int val, const struct timespec64 *end, clockid_t clock_id )
+{
+    int ret;
+
+    if (end)
+    {
+        struct timespec now;
+        long long ns;
+
+        clock_gettime( clock_id, &now );
+        ns = (end->tv_sec - now.tv_sec) * 1000000000LL + (end->tv_nsec - now.tv_nsec);
+        if (ns <= 0)
+        {
+            errno = ETIMEDOUT;
+            return -1;
+        }
+        ret = os_sync_wait_on_address_with_timeout( addr, (uint32_t)val, sizeof(*addr),
+                                                    OS_SYNC_WAIT_ON_ADDRESS_SHARED,
+                                                    OS_CLOCK_MACH_ABSOLUTE_TIME, ns );
+    }
+    else ret = os_sync_wait_on_address( addr, (uint32_t)val, sizeof(*addr), OS_SYNC_WAIT_ON_ADDRESS_SHARED );
+
+    return ret < 0 ? -1 : 0;
+}
+
+static int mac_first_changed( const struct futex_waitv *futexes, int count )
+{
+    int i;
+
+    for (i = 0; i < count; i++)
+        if (__atomic_load_n( (int *)u64_to_ptr(futexes[i].uaddr), __ATOMIC_SEQ_CST ) != (int)futexes[i].val)
+            return i;
+    return -1;
+}
+
+/* Same contract as futex_waitv: -1/EAGAIN if a value already differs, -1/ETIMEDOUT on
+ * timeout, otherwise the index of a changed futex (or -1/EAGAIN after a stray wake). */
+static inline int futex_wait_multiple( const struct futex_waitv *futexes,
+        int count, const struct timespec64 *end, clockid_t clock_id )
+{
+    int ret, gen;
+
+    if (count == 1)
+    {
+        if (mac_first_changed( futexes, 1 ) == 0) goto again;
+        ret = mac_wait_on_address( u64_to_ptr(futexes[0].uaddr), futexes[0].val, end, clock_id );
+    }
+    else
+    {
+        __atomic_add_fetch( &mac_wake_slot[1], 1, __ATOMIC_SEQ_CST );
+        gen = __atomic_load_n( &mac_wake_slot[0], __ATOMIC_SEQ_CST );
+        if (mac_first_changed( futexes, count ) >= 0)
+        {
+            __atomic_sub_fetch( &mac_wake_slot[1], 1, __ATOMIC_SEQ_CST );
+            goto again;
+        }
+        ret = mac_wait_on_address( &mac_wake_slot[0], gen, end, clock_id );
+        __atomic_sub_fetch( &mac_wake_slot[1], 1, __ATOMIC_SEQ_CST );
+    }
+    if (ret < 0 && errno == ETIMEDOUT) return -1;
+    if ((ret = mac_first_changed( futexes, count )) >= 0) return ret;
+again:
+    errno = EAGAIN;
+    return -1;
+}
+
+#else
+
 static inline int futex_wait_multiple( const struct futex_waitv *futexes,
         int count, const struct timespec64 *end, clockid_t clock_id )
 {
-#ifdef __linux__
    if (end)
         return syscall( __NR_futex_waitv, futexes, count, 0, end, clock_id );
    else
         return syscall( __NR_futex_waitv, futexes, count, 0, NULL, 0 );
-#else
-   errno = ENOSYS;
-   return -1;
-#endif
 }
 
+#endif
+
 static inline int futex_wake( int *addr, int val )
 {
-#ifdef __linux__
-    return syscall( __NR_futex, addr, 1, val, NULL, 0, 0 );
+#ifdef __APPLE__
+    os_sync_wake_by_address_all( addr, sizeof(*addr), OS_SYNC_WAKE_BY_ADDRESS_SHARED );
+    /* Multi-object waiters sleep on the wake generation instead (see futex_wait_multiple). */
+    __atomic_thread_fence( __ATOMIC_SEQ_CST );
+    if (MAC_WAKE_SLOT && __atomic_load_n( &MAC_WAKE_SLOT[1], __ATOMIC_SEQ_CST ))
