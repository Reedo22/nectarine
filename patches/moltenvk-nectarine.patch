+		budgets[0] = env ? atoi(env) : 0;
+		const char* envT = getenv("MVK_DIAG_DUMP_TEX0");
+		budgets[1] = envT ? atoi(envT) : 8;
+		const char* envC = getenv("MVK_DIAG_DUMP_COMPUTE_N");
+		budgets[2] = envC ? atoi(envC) : 40;
+		const char* delay = getenv("MVK_DIAG_PASS_AFTER");
+		afterSecs = delay ? atoi(delay) : 0;
+		startTime = time(NULL);
+	}
+	int32_t& budget = budgets[kind];
+	if (!tex || !mtlCmdBuff) { return; }
+	if (afterSecs && (time(NULL) - startTime) < afterSecs) { return; }
