+	int myLogIdx = logIdx++;
+	fprintf(stderr, "[mvk-diag] %s %d: %lux%lu fmt=%lu type=%lu usage=%lu draws=%u dispatchesSinceLastPass=%u fs=%016llx\n",
+			(kind == 1) ? "tex0" : (kind == 2) ? "cmpw" : "pass", myLogIdx,
