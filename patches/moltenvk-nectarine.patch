+static float mvkDiagHalfToFloat(uint16_t hv) {	// MVKDIAG
+	int exp = (hv >> 10) & 0x1F; int man = hv & 0x3FF; int sgn = hv >> 15;
+	float v = (exp == 0) ? man / 16384.0f : ldexpf(1.0f + man / 1024.0f, exp - 15);
+	return sgn ? -v : v;
+}
