+			const uint8_t* p8 = (const uint8_t*)tb.contents;
+			NSUInteger nz = 0;
+			for (NSUInteger i = 0; i < nBytes; i++) { if (p8[i]) { nz++; } }
+			const uint16_t* p16 = (const uint16_t*)tb.contents;
+			fprintf(stderr, "[mvk-diag] texelbuf %lux1 fmt=%lu: %lu/%lu bytes nonzero (%.2f%%) first16: %u %u %u %u %u %u %u %u\n",
