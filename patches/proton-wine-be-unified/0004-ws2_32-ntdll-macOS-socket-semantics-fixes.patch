+static NTSTATUS do_getsockopt_bool( HANDLE handle, IO_STATUS_BLOCK *io, int level,
+                                    int option, void *out_buffer, ULONG out_size )
+{
+    NTSTATUS status;
+    int value;
+
+    if ((status = do_getsockopt( handle, io, level, option, &value, sizeof(value) ))) return status;
+
+    value = !!value;
+    memcpy( out_buffer, &value, min( out_size, sizeof(value) ) );
+    if (io) io->Information = out_size < sizeof(value) ? 1 : sizeof(value);
+    return STATUS_SUCCESS;
+}
+
