     return ret;
 }

+#ifdef __APPLE__
+static int compare_addrinfo( const struct addrinfo *a, const struct addrinfo *b )
+{
+    int ret;
+
+#define COMPARE_FIELD(field) if (a->field != b->field) return a->field < b->field ? -1 : 1
+    COMPARE_FIELD( ai_flags );
+    COMPARE_FIELD( ai_family );
+    COMPARE_FIELD( ai_socktype );
+    COMPARE_FIELD( ai_protocol );
+#undef COMPARE_FIELD
+    if ((ret = memcmp( a->ai_addr, b->ai_addr, min( a->ai_addrlen, b->ai_addrlen ) ))) return ret;
+    if (a->ai_addrlen != b->ai_addrlen) return a->ai_addrlen < b->ai_addrlen ? -1 : 1;
+    return 0;
+}
+
+static void sort_addrinfo( struct addrinfo **info )
+{
+    struct addrinfo *remaining = *info, *sorted = NULL, **tail = &sorted;
+
+    while (remaining)
+    {
+        struct addrinfo **best = &remaining, **cursor;
+
+        for (cursor = &remaining; (*cursor)->ai_next; cursor = &(*cursor)->ai_next)
+            if (compare_addrinfo( (*cursor)->ai_next, *best ) < 0) best = &(*cursor)->ai_next;
+        *tail = *best;
+        *best = (*best)->ai_next;
+        tail = &(*tail)->ai_next;
+    }
+    *tail = NULL;
+    *info = sorted;
+}
+#endif
