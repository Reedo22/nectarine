 include/wine/server_protocol.h     | 183 ++++++++++++++++++++++++-----
 server/request_handlers.h          |  64 ++++++++--
 server/request_trace.h             |  87 ++++++++++++--
 4 files changed, 360 insertions(+), 51 deletions(-)

