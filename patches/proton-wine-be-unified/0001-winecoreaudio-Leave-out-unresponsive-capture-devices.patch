index da2ae2dd67b..d2e834ae198 100644
--- a/dlls/winecoreaudio.drv/coreaudio.c
+++ b/dlls/winecoreaudio.drv/coreaudio.c
@@ -30,6 +30,8 @@
 #define GetCurrentProcess __carbon_GetCurrentProcess
 
 #include <stdarg.h>
+#include <pthread.h>
