 #include <errno.h>
 #include <limits.h>
@@ -221,6 +223,80 @@ static NTSTATUS unix_main_loop(void *args)
     return STATUS_SUCCESS;
 }
 
+static AudioComponentInstance get_audiounit(EDataFlow dataflow, AudioDeviceID adevid);
+
+/* Attaching an input-enabled unit to a capture device needs the device to answer coreaudiod.
+ * A device that never does (e.g. a MacBook microphone whose lid cable is disconnected, a dropped
+ * Bluetooth headset) blocks forever, and every IsFormatSupported/Initialize on it then hangs the
+ * whole game, typically during winmm's start-up enumeration. Probe each capture device once per
+ * process on a helper thread and leave out the ones that don't answer within two seconds. */
+struct capture_probe
+{
+    AudioDeviceID id;
+    int done;
+    pthread_mutex_t lock;
+    pthread_cond_t cond;
+};
+
+static void *capture_probe_thread(void *arg)
+{
+    struct capture_probe *probe = arg;
+    AudioComponentInstance unit = get_audiounit(eCapture, probe->id);
+
+    if (unit) AudioComponentInstanceDispose(unit);
+    pthread_mutex_lock(&probe->lock);
+    probe->done = 1;
+    pthread_cond_signal(&probe->cond);
+    pthread_mutex_unlock(&probe->lock);
+    return NULL;
+}
+
+static BOOL capture_device_responds(AudioDeviceID id)
+{
+    static pthread_mutex_t cache_lock = PTHREAD_MUTEX_INITIALIZER;
+    static struct { AudioDeviceID id; BOOL ok; } cache[32];
+    static unsigned int cache_count;
+    struct capture_probe *probe;
+    struct timespec deadline;
+    pthread_t thread;
+    unsigned int i;
+    BOOL ok;
+
+    pthread_mutex_lock(&cache_lock);
+    for (i = 0; i < cache_count; i++)
+        if (cache[i].id == id) { ok = cache[i].ok; pthread_mutex_unlock(&cache_lock); return ok; }
+
+    /* leaked on timeout: the stuck thread still owns it */
+    if (!(probe = calloc(1, sizeof(*probe)))) { pthread_mutex_unlock(&cache_lock); return TRUE; }
+    probe->id = id;
+    pthread_mutex_init(&probe->lock, NULL);
+    pthread_cond_init(&probe->cond, NULL);
+    if (pthread_create(&thread, NULL, capture_probe_thread, probe))
+    {
+        free(probe);
+        pthread_mutex_unlock(&cache_lock);
+        return TRUE;
+    }
+    pthread_detach(thread);
+
+    clock_gettime(CLOCK_REALTIME, &deadline);
+    deadline.tv_sec += 2;
+    pthread_mutex_lock(&probe->lock);
+    while (!probe->done && pthread_cond_timedwait(&probe->cond, &probe->lock, &deadline) != ETIMEDOUT);
+    ok = probe->done;
+    pthread_mutex_unlock(&probe->lock);
+    if (ok) free(probe);
+    else WARN("capture device %u does not respond; leaving it out\n", (unsigned int)id);
+
+    if (cache_count < ARRAY_SIZE(cache))
+    {
+        cache[cache_count].id = id;
+        cache[cache_count++].ok = ok;
+    }
+    pthread_mutex_unlock(&cache_lock);
+    return ok;
+}
