 	_vertexModule = getOrCreateShaderModule(device, pVertexSS, _ownsVertexModule);
+	// Metal has no geometry stage. A GS that only forwards its triangle and copies one input
+	// varying into Layer (D3D11 SV_RenderTargetArrayIndex; UE uses it for its color-grading LUT)
+	// is exactly a vertex shader that exports Layer, so rewrite the VS that way. Anything else
+	// fails closed and is reported, instead of the GS being silently dropped.
+	if (pGeometrySS && _vertexModule && pVertexSS && !getenv("MVK_X_NO_GS_LOWERING")) {
