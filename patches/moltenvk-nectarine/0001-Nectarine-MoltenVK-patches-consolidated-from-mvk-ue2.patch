+bool mvkxKprofEnabled() { static const bool on = getenv("MVK_X_KPROF") != nullptr; return on; }
+id<MTLCounterSampleBuffer> mvkxKprofSampleBuffer() { return gMVKXKprofBuf; }
+
+static void mvkxKprofInit(id<MTLDevice> dev) {
+	if (gMVKXKprofBuf || !dev) { return; }
+	id<MTLCounterSet> tsSet = nil;
+	for (id<MTLCounterSet> cs in dev.counterSets) {
+		if ([cs.name isEqualToString: MTLCommonCounterSetTimestamp]) { tsSet = cs; break; }
+	}
+	if ( !tsSet || ![dev supportsCounterSampling: MTLCounterSamplingPointAtStageBoundary] ) {
+		fprintf(stderr, "[mvkx-kprof] stage-boundary timestamps unsupported on this GPU\n"); return;
+	}
+	MTLCounterSampleBufferDescriptor* d = [MTLCounterSampleBufferDescriptor new];
+	d.counterSet = tsSet; d.storageMode = MTLStorageModeShared; d.sampleCount = 2 * kMVKXKprofSlots;
+	NSError* err = nil;
+	gMVKXKprofBuf = [dev newCounterSampleBufferWithDescriptor: d error: &err];	// retained for process life
+	[d release];
+	if ( !gMVKXKprofBuf ) { fprintf(stderr, "[mvkx-kprof] sample buffer failed: %s\n", err.localizedDescription.UTF8String); return; }
+	gMVKXDev = [dev retain];
+	[dev sampleTimestamps: &gMVKXCpu0 gpuTimestamp: &gMVKXGpu0];
+	fprintf(stderr, "[mvkx-kprof] enabled: %u slots\n", kMVKXKprofSlots);
+}
+
+static void mvkxKprofDumpLocked() {
+	MTLTimestamp c1, g1; [gMVKXDev sampleTimestamps: &c1 gpuTimestamp: &g1];
+	double nsPerTick = (g1 > gMVKXGpu0) ? (double)(c1 - gMVKXCpu0) / (double)(g1 - gMVKXGpu0) : 1.0;
+	std::vector<std::pair<uint64_t, MVKXKprofAcc>> v(gMVKXKprofAcc.begin(), gMVKXKprofAcc.end());
+	std::sort(v.begin(), v.end(), [](auto& a, auto& b) { return a.second.ticks > b.second.ticks; });
+	double totMs = 0; for (auto& e : v) { totMs += e.second.ticks * nsPerTick / 1e6; }
+	double winS = (c1 - gMVKXFirstNs) / 1e9;
+	fprintf(stderr, "[mvkx-kprof] ---- window %.1fs, compute GPU %.1f ms total (%.1f ms/s), ns/tick %.4f\n",
+			winS, totMs, winS > 0 ? totMs / winS : 0, nsPerTick);
+	for (size_t i = 0; i < v.size() && i < 25; i++) {
+		double ms = v[i].second.ticks * nsPerTick / 1e6;
+		fprintf(stderr, "[mvkx-kprof] %016llx n=%7llu  total=%9.1f ms  %5.1f%%  avg=%8.1f us\n",
+				(unsigned long long)v[i].first, (unsigned long long)v[i].second.n, ms,
+				totMs > 0 ? 100.0 * ms / totMs : 0, v[i].second.n ? 1000.0 * ms / v[i].second.n : 0);
+	}
+	gMVKXKprofAcc.clear(); gMVKXFirstNs = c1;
+}
+
+// Called by the dispatch commands. Returns the slot, or UINT32_MAX when profiling is off.
+uint32_t mvkxKprofBegin(MVKCommandEncoder* cmdEncoder) {
+	if ( !mvkxKprofEnabled() ) { return UINT32_MAX; }
+	{ std::lock_guard<std::mutex> lk(gMVKXKprofLock); mvkxKprofInit(cmdEncoder->getMTLDevice()); }
+	if ( !gMVKXKprofBuf ) { return UINT32_MAX; }
+	cmdEncoder->endCurrentMetalEncoding();	// the next getMTLComputeEncoder() creates a sampled encoder
+	uint32_t slot;
+	{ std::lock_guard<std::mutex> lk(gMVKXKprofLock); slot = gMVKXKprofNext; gMVKXKprofNext = (gMVKXKprofNext + 1) % kMVKXKprofSlots; }
+	cmdEncoder->_mvkxKprofSlot = slot;
+	return slot;
+}
+
+void mvkxKprofEnd(MVKCommandEncoder* cmdEncoder, uint32_t slot, uint64_t hash) {
+	if (slot == UINT32_MAX) { return; }
+	cmdEncoder->endCurrentMetalEncoding();
+	[cmdEncoder->_mtlCmdBuffer addCompletedHandler: ^(id<MTLCommandBuffer> mcb) {
+		NSData* d = [gMVKXKprofBuf resolveCounterRange: NSMakeRange(2 * slot, 2)];
+		if ( !d || d.length < 2 * sizeof(MTLCounterResultTimestamp) ) { return; }
+		auto* ts = (const MTLCounterResultTimestamp*)d.bytes;
+		if (ts[0].timestamp == MTLCounterErrorValue || ts[1].timestamp == MTLCounterErrorValue ||
+			ts[1].timestamp <= ts[0].timestamp) { return; }
+		std::lock_guard<std::mutex> lk(gMVKXKprofLock);
+		auto& a = gMVKXKprofAcc[hash]; a.n++; a.ticks += ts[1].timestamp - ts[0].timestamp;
+		uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+		if ( !gMVKXFirstNs ) { gMVKXFirstNs = now; gMVKXLastDumpNs = now; }
+		if (now - gMVKXLastDumpNs > 5000000000ull) { gMVKXLastDumpNs = now; mvkxKprofDumpLocked(); }
+	}];
+}
