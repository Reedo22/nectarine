 VkFormatProperties3& MVKPixelFormats::getVkFormatProperties3(VkFormat vkFormat) {
+	// MVKX: UE5 builds its HZB as R16_SFLOAT but its HZB shaders declare the storage image as
+	// R32f. Vulkan says a storage-image format mismatch yields undefined values for the whole
+	// image, and the HZB measurably contains values larger than the depth buffer it reduces.
+	// Withholding STORAGE_IMAGE from R16_SFLOAT pushes UE5 onto a wider format that matches
+	// its shader. Opt-in, because it changes advertised capabilities.
+	if (vkFormat == VK_FORMAT_R16_SFLOAT) {
+		static int noR16FStorage = -1;
+		if (noR16FStorage < 0) { noR16FStorage = getenv("MVK_X_NO_R16F_STORAGE") ? 1 : 0; }
+		if (noR16FStorage) {
+			auto& d = getVkFormatDesc(vkFormat);
+			d.properties.optimalTilingFeatures &= ~(VK_FORMAT_FEATURE_2_STORAGE_IMAGE_BIT |
+													VK_FORMAT_FEATURE_2_STORAGE_READ_WITHOUT_FORMAT_BIT |
+													VK_FORMAT_FEATURE_2_STORAGE_WRITE_WITHOUT_FORMAT_BIT);
+			d.properties.linearTilingFeatures &= ~(VK_FORMAT_FEATURE_2_STORAGE_IMAGE_BIT |
+												   VK_FORMAT_FEATURE_2_STORAGE_READ_WITHOUT_FORMAT_BIT |
+												   VK_FORMAT_FEATURE_2_STORAGE_WRITE_WITHOUT_FORMAT_BIT);
+			return d.properties;
+		}
+	}
 	return getVkFormatDesc(vkFormat).properties;
 }
 
