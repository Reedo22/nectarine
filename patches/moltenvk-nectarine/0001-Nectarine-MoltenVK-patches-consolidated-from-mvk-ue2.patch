+// MVK_X_LABEL_DISPATCH=1: profiling aid. Gives every dispatch its own compute encoder labelled
+// "cs <codeHash> tg AxBxC g XxYxZ" so a Metal System Trace attributes GPU time per kernel.
+// codeHash matches the shader-cs-<hash>.metal files written by MVK_CONFIG_SHADER_DUMP_DIR.
+// Ending the encoder per dispatch adds overhead, so use it to rank kernels, not to time frames.
+#include <cstdlib>
+extern uint64_t mvkDiagGetCompHash(const void*);
+static bool mvkxLabelDispatch() { static const bool on = getenv("MVK_X_LABEL_DISPATCH") != nullptr; return on; }
+static void mvkxLabelAndSplit(MVKCommandEncoder* cmdEncoder, id<MTLComputeCommandEncoder> enc,
+							  MVKComputePipeline* pipeline, MTLSize groups, bool indirect) {
+	if ( !mvkxLabelDispatch() ) { return; }
+	MTLSize tg = pipeline->getThreadgroupSize();
+	char lbl[128];
+	if (indirect) {
+		snprintf(lbl, sizeof(lbl), "cs %016llx tg %lux%lux%lu indirect",
+				 (unsigned long long)mvkDiagGetCompHash(pipeline),
+				 (unsigned long)tg.width, (unsigned long)tg.height, (unsigned long)tg.depth);
+	} else {
+		snprintf(lbl, sizeof(lbl), "cs %016llx tg %lux%lux%lu g %lux%lux%lu",
+				 (unsigned long long)mvkDiagGetCompHash(pipeline),
+				 (unsigned long)tg.width, (unsigned long)tg.height, (unsigned long)tg.depth,
+				 (unsigned long)groups.width, (unsigned long)groups.height, (unsigned long)groups.depth);
+	}
+	enc.label = @(lbl);
+}
+
 void MVKCmdDispatch::encode(MVKCommandEncoder* cmdEncoder) {
+	{ extern uint32_t gMVKDiagDispatchCount; gMVKDiagDispatchCount++; }	// MVKDIAG
 	MTLRegion mtlThreadgroupCount = MTLRegionMake3D(_baseGroupX, _baseGroupY, _baseGroupZ, _groupCountX, _groupCountY, _groupCountZ);
+	if (mvkxLabelDispatch()) {
+		// Instruments snapshots the label at the encoder's first command, so open the encoder and
+		// label it before finalizeDispatchState() binds the pipeline and resources into it.
+		cmdEncoder->endCurrentMetalEncoding();
+		mvkxLabelAndSplit(cmdEncoder, cmdEncoder->getMTLComputeEncoder(kMVKCommandUseDispatch),
+						  cmdEncoder->getComputePipeline(), mtlThreadgroupCount.size, false);
+	}
+	extern uint32_t mvkxKprofBegin(MVKCommandEncoder*);
+	extern void mvkxKprofEnd(MVKCommandEncoder*, uint32_t, uint64_t);
+	uint32_t kprofSlot = mvkxKprofBegin(cmdEncoder);
 	cmdEncoder->finalizeDispatchState();	// Ensure all updated state has been submitted to Metal
 	id<MTLComputeCommandEncoder> mtlEncoder = cmdEncoder->getMTLComputeEncoder(kMVKCommandUseDispatch);
 	auto* pipeline = cmdEncoder->getComputePipeline();
+	{	// MVKDIAG
+		extern uint64_t mvkDiagGetCompHash(const void*);
+		extern uint64_t gMVKDiagLastCompHash;
+		gMVKDiagLastCompHash = mvkDiagGetCompHash(pipeline);
+	}
 	if (pipeline->allowsDispatchBase()) {
 		// We'll use the stage-input region to pass the base along to the shader.
 		// Hopefully Metal won't complain that we didn't set up a stage-input descriptor.
@@ -54,6 +96,8 @@
 	}
 	[mtlEncoder dispatchThreadgroups: mtlThreadgroupCount.size
