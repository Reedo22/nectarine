+// MVKX: count render-pass restarts by call site. Each restart costs a full attachment
+// store+reload on tile GPUs, and the trace put them at 13% of total GPU time.
+#include <map>
+static void mvkxRestart(int line) {
+    if (!getenv("MVK_X_PASSSTATS")) { return; }
+    static std::map<int,unsigned long> counts;
+    static time_t last = 0;
+    counts[line]++;
+    time_t now = time(NULL);
+    if (!last) { last = now; return; }
+    if (now - last < 5) { return; }
+    fprintf(stderr, "[mvk-restarts] per 5s:");
+    for (auto& kv : counts) { fprintf(stderr, " line%d=%lu", kv.first, kv.second); }
+    fprintf(stderr, "\n");
+    counts.clear();
+    last = now;
+}
+
+
+// MVK_X_SEQLOG=<n>: after MVK_X_SEQLOG_AFTER s, log the next n copy / indirect-draw recordings
+// with the exact MTLBuffer + offset they touch (decides whether hoisting copies is safe).
+#include <cstdio>
+#include <cstdlib>
+#include <ctime>
+static bool mvkxSeqLogTick() {
+	static long budget = -2; static time_t t0 = 0; static long after = 0;
+	if (budget == -2) { const char* e = getenv("MVK_X_SEQLOG"); budget = e ? atol(e) : -1;
+		const char* a = getenv("MVK_X_SEQLOG_AFTER"); after = a ? atol(a) : 40; t0 = time(NULL); }
+	if (budget <= 0 || time(NULL) - t0 < after) { return false; }
+	budget--; return true;
+}
 
