 // Present the drawable and make myself available only once the command buffer has completed.
 // Pass MVKImagePresentInfo by value because it may not exist when the callback runs.
+// MVKDIAG: dump the image actually handed to the display, so what the game presents can be
+// inspected without screen capture (screencapture on this machine returns a stale framebuffer).
+// Set MVK_DIAG_DUMP_PRESENT=<n> to write every n-th presented frame to /tmp/mvk-present-<i>.ppm.
+static void mvkDiagDumpPresentedImage(id<MTLTexture> tex, id<MTLCommandBuffer> mtlCmdBuff) {
+	static int32_t interval = -1;
+	static uint64_t frameCount = 0;
+	static int32_t dumpIdx = 0;
+	static time_t startTime = 0;
+	static time_t afterSecs = 0;
+	if (interval < 0) {
+		const char* env = getenv("MVK_DIAG_DUMP_PRESENT");
+		interval = env ? atoi(env) : 0;
+		const char* delay = getenv("MVK_DIAG_PRESENT_AFTER");
+		afterSecs = delay ? atoi(delay) : 0;
+		startTime = time(NULL);
+	}
+	if (afterSecs && (time(NULL) - startTime) < afterSecs) { return; }
+	if (interval <= 0 || !tex) { return; }
+	fprintf(stderr, "[mvk-diag] ---- frame %llu presented ----\n", (unsigned long long)frameCount);
+	if ((frameCount++ % (uint64_t)interval) != 0) { return; }
+	if (dumpIdx >= 24) { return; }
+
+	NSUInteger w = tex.width, h = tex.height, bpr = w * 4;
+	id<MTLDevice> dev = mtlCmdBuff.device;
+	id<MTLBuffer> buf = [dev newBufferWithLength: bpr * h options: MTLResourceStorageModeShared];
+	if (!buf) { return; }
+	id<MTLBlitCommandEncoder> blit = [mtlCmdBuff blitCommandEncoder];
+	[blit copyFromTexture: tex sourceSlice: 0 sourceLevel: 0
+			 sourceOrigin: MTLOriginMake(0, 0, 0) sourceSize: MTLSizeMake(w, h, 1)
+				 toBuffer: buf destinationOffset: 0
+		destinationBytesPerRow: bpr destinationBytesPerImage: bpr * h];
+	[blit endEncoding];
+
+	int idx = dumpIdx++;
+	MTLPixelFormat pixFmt = tex.pixelFormat;
+	fprintf(stderr, "[mvk-diag] present dump %d: %lux%lu MTLPixelFormat=%lu\n", idx,
+			(unsigned long)w, (unsigned long)h, (unsigned long)pixFmt);
+	[mtlCmdBuff addCompletedHandler: ^(id<MTLCommandBuffer> mcb) {
+		char path[128];
+		snprintf(path, sizeof(path), "/tmp/mvk-present-%d.ppm", idx);
+		FILE* f = fopen(path, "wb");
+		if (f) {
+			fprintf(f, "P6\n%lu %lu\n255\n", (unsigned long)w, (unsigned long)h);
+			const uint8_t* src = (const uint8_t*)buf.contents;
+			bool bgra8 = (pixFmt == MTLPixelFormatBGRA8Unorm || pixFmt == MTLPixelFormatBGRA8Unorm_sRGB);
+			bool rgba8 = (pixFmt == MTLPixelFormatRGBA8Unorm || pixFmt == MTLPixelFormatRGBA8Unorm_sRGB);
+			bool rgb10 = (pixFmt == MTLPixelFormatRGB10A2Unorm);
+			bool bgr10 = (pixFmt == MTLPixelFormatBGR10A2Unorm);
+			for (NSUInteger y = 0; y < h; y++) {
+				const uint8_t* row = src + y * bpr;
+				for (NSUInteger x = 0; x < w; x++) {
+					const uint8_t* px = row + x * 4;
+					uint8_t rgb[3];
+					if (rgb10 || bgr10) {
+						uint32_t v = ((const uint32_t*)row)[x];
+						uint32_t c0 = v & 0x3FF, c1 = (v >> 10) & 0x3FF, c2 = (v >> 20) & 0x3FF;
+						uint32_t r = rgb10 ? c0 : c2, g = c1, b = rgb10 ? c2 : c0;
+						rgb[0] = (uint8_t)(r >> 2); rgb[1] = (uint8_t)(g >> 2); rgb[2] = (uint8_t)(b >> 2);
+					} else if (rgba8) {
+						rgb[0] = px[0]; rgb[1] = px[1]; rgb[2] = px[2];
+					} else {	// assume BGRA8
+						rgb[0] = px[2]; rgb[1] = px[1]; rgb[2] = px[0];
+					}
+					(void)bgra8;
+					fwrite(rgb, 1, 3, f);
+				}
+			}
+			fclose(f);
+		}
+		[buf release];
+	}];
+	[buf retain];
+	[buf release];
+}
