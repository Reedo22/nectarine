+/* Observe actual drawable presentation, never allocation or command submission.
+ * Install on the base class so the same health signal covers all three backends.
+ * A PID check prevents inherited state from marking the launching process good. */
+__attribute__((constructor)) static void nectarine_install_present_health(void)
+{
+    const char *owner = getenv( "_NECTARINE_BACKEND_OWNER" );
+    static pthread_mutex_t mutex = PTHREAD_MUTEX_INITIALIZER;
+    static unsigned int frames;
+    static double first;
+    static int good;
+    if (!owner || strtol( owner, NULL, 10 ) != getpid()) return;
+    SEL sel = @selector(nextDrawable);
+    Method method = class_getInstanceMethod( [CAMetalLayer class], sel );
+    IMP original = method_getImplementation( method );
+    method_setImplementation( method, imp_implementationWithBlock(^id(CAMetalLayer *layer) {
+        id<CAMetalDrawable> drawable = ((id (*)(id, SEL))original)(layer, sel);
+        pthread_mutex_lock( &mutex );
+        int observe = !good;
+        pthread_mutex_unlock( &mutex );
+        if (drawable && observe) [drawable addPresentedHandler:^(id<MTLDrawable> presented) {
+            struct timespec ts;
+            clock_gettime( CLOCK_MONOTONIC, &ts );
+            double now = ts.tv_sec + ts.tv_nsec / 1e9;
+            pthread_mutex_lock( &mutex );
+            if (!frames++) first = now;
+            if (!good && frames >= 120 && now - first >= 20.0)
+                good = nectarine_backend_write( "good" );
+            pthread_mutex_unlock( &mutex );
+        }];
+        return drawable;
+    }));
+}
