+/* Nectarine backend state shared by ntdll and the native presentation callback.
+ * Internal environment values are PID-scoped; children must never mark a parent good.
+ * The selector holds a separate flock for the process lifetime. Atomic rename keeps
+ * readers from observing partial records. SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#ifndef __WINE_NECTARINE_BACKEND_H
+#define __WINE_NECTARINE_BACKEND_H
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <fcntl.h>
+
+static inline int nectarine_backend_write( const char *phase )
+{
+    const char *path = getenv( "_NECTARINE_BACKEND_STATE" );
+    const char *owner = getenv( "_NECTARINE_BACKEND_OWNER" );
+    const char *backend = getenv( "CX_ACTIVE_GRAPHICS_BACKEND" );
+    char tmp[4096], record[128];
+    int fd, len, ok;
+    if (!path || !owner || !backend || strtol( owner, NULL, 10 ) != getpid()) return 0;
+    if (snprintf( tmp, sizeof(tmp), "%s.XXXXXX", path ) >= (int)sizeof(tmp)) return 0;
+    if ((fd = mkstemp( tmp )) == -1) return 0;
+    len = snprintf( record, sizeof(record), "%s %s pid=%s\n", phase, backend, owner );
+    ok = write( fd, record, len ) == len;
+    if (ok) ok = !fsync( fd );
+    if (close( fd )) ok = 0;
+    if (ok) ok = !rename( tmp, path );
+    if (!ok) unlink( tmp );
+    if (ok && getenv( "NECTARINE_GRAPHICS_TRACE" ))
+        fprintf( stderr, "wine: backend-state=%s %s state=%s\n", phase, backend, path );
+    return ok;
+}
+#endif
