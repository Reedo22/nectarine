 using namespace std;
 
 
+#pragma mark MVKQueryAvailability
+
+MVKQueryAvailability::MVKQueryAvailability(id<MTLSharedEvent> event, uint64_t value,
+                                         const std::shared_ptr<std::atomic<uint64_t>>& cpuTimestamp)
+    : _event([event retain]), _value(value), _cpuTimestamp(cpuTimestamp) {}
+
+MVKQueryAvailability::~MVKQueryAvailability() {
+    [_listener release];
+    [_event release];
+}
+
+bool MVKQueryAvailability::isAvailable() const { return _event.signaledValue >= _value; }
+
+uint64_t MVKQueryAvailability::getTimestamp() {
+    uint64_t timestamp = _cpuTimestamp->load();
+    if (!timestamp) {
+        uint64_t current = mvkGetElapsedNanoseconds();
+        if (_cpuTimestamp->compare_exchange_strong(timestamp, current)) { timestamp = current; }
+    }
+    return timestamp;
+}
+
+void MVKQueryAvailability::wait() {
+    unique_lock<mutex> lock(_lock);
+    if (isAvailable()) { return; }
+    if (!_listener) {
+        _listener = [MTLSharedEventListener new];
+        std::weak_ptr<MVKQueryAvailability> weak = shared_from_this();
+        [_event notifyListener: _listener atValue: _value block: ^(id<MTLSharedEvent> event, uint64_t value) {
+            if (auto signal = weak.lock()) { signal->_blocker.notify_all(); }
+        }];
+    }
+    // Periodically return so the query pool can notice device loss as well.
+    _blocker.wait_for(lock, chrono::milliseconds(10), [this] { return isAvailable(); });
+}
