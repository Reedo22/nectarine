+// Publish timestamp availability at the end of its sample encoders, so host query
+// reads do not depend on whole-command-buffer completion (which may wait on the host).
+void MVKCommandEncoder::publishTimestampQueries() {
+    if (!_pActivatedQueries) { return; }
+    auto* pending = new MVKActivatedQueries;
+    for (auto it = _pActivatedQueries->begin(); it != _pActivatedQueries->end();) {
+        if (it->first->publishesTimestampResults()) {
+            pending->emplace(it->first, std::move(it->second));
+            it = _pActivatedQueries->erase(it);
+        } else { ++it; }
+    }
+    if (pending->empty()) { delete pending; return; }
+    auto queries = mvkRetainQueryPools(pending);
