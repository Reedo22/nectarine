+// Keep query pools alive until delayed Metal completion handlers release them.
+static std::shared_ptr<MVKActivatedQueries> mvkRetainQueryPools(MVKActivatedQueries* queries) {
+    for (auto& pair : *queries) { pair.first->retain(); }
+    return std::shared_ptr<MVKActivatedQueries>(queries, [](MVKActivatedQueries* retained) {
+        for (auto& pair : *retained) { pair.first->release(); }
+        delete retained;
+    });
