 // Ensure that the type is compatible with the shader input.
 // If it is, simply return the given type ID.
 // Otherwise, create a new type, and return its ID.
+// Record every Metal resource index the app explicitly assigned for this entry point, so that
+// resources the app did not bind can be allocated indices that do not collide with them.
+void CompilerMSL::collect_claimed_msl_resource_indices()
+{
+	claimed_msl_buffer_indices.clear();
+	claimed_msl_texture_indices.clear();
+	claimed_msl_sampler_indices.clear();
+
+	auto model = get_entry_point().model;
+	for (auto &binding : resource_bindings)
+	{
+		if (binding.first.model != model)
+			continue;
+		auto &rb = binding.second.first;
+		switch (rb.basetype)
+		{
+		case SPIRType::Image:
+		case SPIRType::SampledImage:
+			claimed_msl_texture_indices.insert(rb.msl_texture);
+			if (rb.basetype == SPIRType::SampledImage)
+				claimed_msl_sampler_indices.insert(rb.msl_sampler);
+			break;
+		case SPIRType::Sampler:
+			claimed_msl_sampler_indices.insert(rb.msl_sampler);
+			break;
+		default:
+			claimed_msl_buffer_indices.insert(rb.msl_buffer);
+			break;
+		}
+	}
+}
+
+// Return the next index of a resource type that the app has not explicitly claimed, and advance the
+// counter past it. An app is not obliged to describe every resource a shader declares - a pipeline
+// layout may omit a descriptor set, or not list the stage - and without this, such a resource would
+// be handed an index another resource already occupies, which Metal refuses to compile.
+uint32_t CompilerMSL::allocate_unclaimed_msl_resource_index(uint32_t &next_index, uint32_t stride,
+                                                            const std::unordered_set<uint32_t> &claimed)
+{
+	if (!claimed.empty())
+	{
+		for (;;)
+		{
+			bool collides = false;
+			for (uint32_t i = 0; i < stride && !collides; i++)
+				collides = claimed.count(next_index + i) != 0;
+			if (!collides)
+				break;
+			next_index++;
+		}
+	}
+
+	uint32_t index = next_index;
+	next_index += stride;
+	return index;
+}
