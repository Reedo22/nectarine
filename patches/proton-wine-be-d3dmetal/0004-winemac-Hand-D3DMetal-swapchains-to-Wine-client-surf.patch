     - (CALayer*) makeBackingLayer
     {
+#if defined(__APPLE__) && defined(__x86_64__)
+        CAMetalLayer *layer = d3dmetal_enabled ? [WineMetalLayer layer] : [CAMetalLayer layer];
+#else
         CAMetalLayer *layer = [CAMetalLayer layer];
+#endif
