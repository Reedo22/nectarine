index 00000000000..90c1dc9be96
--- /dev/null
+++ b/dlls/winemac.drv/d3dmetal_objc.m
@@ -0,0 +1,81 @@
+/*
+ * Mac graphics driver hooks used by D3DMetal (part of the Apple Game Porting Toolkit)
