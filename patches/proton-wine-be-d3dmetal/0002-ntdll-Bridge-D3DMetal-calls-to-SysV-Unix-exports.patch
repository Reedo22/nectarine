 dlls/ntdll/unix/sync.c         | 100 ++++++++++++++++++++++++++++++---
 dlls/ntdll/unix/thread.c       |  18 +++++-
 dlls/ntdll/unix/unix_private.h |  39 +++++++++++++
 4 files changed, 162 insertions(+), 9 deletions(-)

