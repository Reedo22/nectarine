 /**************************************************************************
  *           NtClose
  */
-NTSTATUS WINAPI NtClose( HANDLE handle )
+NTSTATUS WINAPI GPT_IMPORT(NtClose)( HANDLE handle )
 {
     sigset_t sigset;
     HANDLE port;
@@ -1997,6 +1997,18 @@ NTSTATUS WINAPI NtClose( HANDLE handle )
     return ret;
 }
 
+/* CW Hack 23015 */
+#if defined(__APPLE__) && defined(__x86_64__)
+
