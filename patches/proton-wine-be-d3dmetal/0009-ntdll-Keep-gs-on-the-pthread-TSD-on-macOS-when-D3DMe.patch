diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index 1e4833b5bd9..1246c126249 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -4586,6 +4586,26 @@ NTSTATUS virtual_clear_tls_index( ULONG index )
 }
 
 
+#if defined(__APPLE__) && defined(__x86_64__)
+/***********************************************************************
+ *           virtual_clear_macos_thread_tls
+ *
+ * A terminated thread can remain in teb_list until another thread joins it.
+ * Retire its TSD mirror before pthread_exit(), including on forced termination
+ * which skips LdrShutdownThread(). Serialize with TLS vector replacement so
+ * another thread cannot write into freed or reused pthread storage.
+ */
+void virtual_clear_macos_thread_tls(void)
+{
+    sigset_t sigset;
+
+    server_enter_uninterrupted_section( &virtual_mutex, &sigset );
+    NtCurrentTeb()->Instrumentation[0] = NULL;
+    server_leave_uninterrupted_section( &virtual_mutex, &sigset );
+}
+#endif
+
+
 /***********************************************************************
  *           virtual_set_tls_information_teb
  */
@@ -4631,7 +4651,8 @@ static NTSTATUS virtual_set_tls_information_teb( PROCESS_TLS_INFORMATION *t, uns
                 memcpy( ptr, teb->ThreadLocalStoragePointer, sizeof(*ptr) * t->TlsVectorLength );
                 t->ThreadData[*idx].TlsVector = InterlockedExchangePointer( &teb->ThreadLocalStoragePointer, ptr );
                 t->ThreadData[*idx].ThreadId = HandleToULong( teb->ClientId.UniqueThread );
-#ifdef __x86_64__  /* macOS-specific hack */
+#ifdef __x86_64__  /* Instrumentation[0] is set only in macOS pthread gsbase mode. */
+                /* alloc_tls_slot() replaces vectors here while holding virtual_mutex. */
                 if (teb->Instrumentation[0]) ((TEB *)teb->Instrumentation[0])->ThreadLocalStoragePointer = ptr;
 #endif
             }
diff --git a/tools/gsbase-probe.c b/tools/gsbase-probe.c
new file mode 100644
index 00000000000..49c0184b6ee
--- /dev/null
+++ b/tools/gsbase-probe.c
@@ -0,0 +1,216 @@
+/* Manual x86_64 macOS gsbase regression probe; see GSBASE-MODEL.md.
+ * Build against this tree's Windows headers with a MinGW compiler.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include <stdio.h>
+#include <string.h>
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windows.h"
+#include "winternl.h"
+
+#if !defined(__x86_64__) || defined(__arm64ec__)
+#error This probe requires x86_64 PE code.
+#endif
+
+static BOOL pthread_mode;
+static DWORD tls_index;
+static LONG failures, exceptions, gs_faults;
+static BOOL expect_gs_fault;
+static HANDLE ready, resume;
+static DWORD (WINAPI *tls_functions[96])( DWORD );
+
+#define check(cond) do { if (!(cond)) { \
+    fprintf( stderr, "FAIL line %u, thread %lu: %s\n", __LINE__, GetCurrentThreadId(), #cond ); \
+    InterlockedIncrement( &failures ); } } while (0)
+
+static void check_teb(void)
+{
+    TEB *teb = NtCurrentTeb();
+    void *self, *tls, *peb, **expansion;
+    void *value = ULongToPtr( GetCurrentThreadId() );
+    THREAD_BASIC_INFORMATION info;
+
+    check( !!teb->Instrumentation[0] == pthread_mode );
+    check( !NtQueryInformationThread( GetCurrentThread(), ThreadBasicInformation, &info, sizeof(info), NULL ));
+    check( info.TebBaseAddress == teb );
+    __asm__ volatile( "movq %%gs:0x30,%0" : "=r" (self) );
+    __asm__ volatile( "movq %%gs:0x58,%0" : "=r" (tls) );
+    __asm__ volatile( "movq %%gs:0x60,%0" : "=r" (peb) );
+    check( self == teb );
+    check( tls == teb->ThreadLocalStoragePointer );
+    check( peb == teb->Peb );
+    check( TlsSetValue( tls_index, value ) );
+    check( TlsGetValue( tls_index ) == value );
+    if (pthread_mode)
+    {
+        check( tls_index >= TLS_MINIMUM_AVAILABLE );
+        __asm__ volatile( "movq %%gs:0x1780,%0" : "=r" (expansion) );
+        check( expansion && expansion == teb->TlsExpansionSlots );
+        if (expansion && tls_index >= TLS_MINIMUM_AVAILABLE)
+            check( expansion[tls_index - TLS_MINIMUM_AVAILABLE] == value );
+    }
+}
+
+static LONG CALLBACK exception_handler( EXCEPTION_POINTERS *ptr )
+{
+    if (ptr->ExceptionRecord->ExceptionCode == 0xe0424242)
+    {
+        InterlockedIncrement( &exceptions );
+        return EXCEPTION_CONTINUE_EXECUTION;
+    }
+    if (expect_gs_fault && ptr->ExceptionRecord->ExceptionCode == EXCEPTION_ACCESS_VIOLATION &&
+        ptr->ExceptionRecord->NumberParameters == 2 && !ptr->ExceptionRecord->ExceptionInformation[1] &&
+        !memcmp( (void *)ptr->ContextRecord->Rip, "\x65\x48\x8b\x00", 4 ))
+    {
+        /* movq %gs:(%rax),%rax: check that gsbase repair does not retry forever. */
+        ptr->ContextRecord->Rip += 4;
+        InterlockedIncrement( &gs_faults );
+        return EXCEPTION_CONTINUE_EXECUTION;
+    }
+    return EXCEPTION_CONTINUE_SEARCH;
+}
+
+static DWORD WINAPI worker( void *arg )
+{
+    unsigned int i;
+
+    for (i = 0; i < 32; i++)
+    {
+        check_teb();
+        Sleep(0);
+    }
+    RaiseException( 0xe0424242, 0, 0, NULL );
+    check_teb();
+    return 0;
+}
+
+static DWORD WINAPI tls_worker( void *arg )
+{
+    unsigned int i;
+
+    check_teb();
+    SetEvent( ready );
+    WaitForSingleObject( resume, INFINITE );
+    check_teb();
+    for (i = 0; i < ARRAY_SIZE(tls_functions); i++)
+        check( tls_functions[i]( GetCurrentThreadId() ) == 0x1234abcd );
+    return 0;
+}
+
+static DWORD WINAPI victim( void *arg )
+{
+    SetEvent( ready );
+    Sleep(INFINITE);
+    return 0;
+}
+
+static void load_tls_dlls( const char *dir, unsigned int first, unsigned int end )
+{
+    char path[MAX_PATH];
+    unsigned int i;
+    HMODULE module;
+
+    for (i = first; i < end; i++)
+    {
+        snprintf( path, sizeof(path), "%s/gsbase-tls-%u.dll", dir, i );
+        module = LoadLibraryA( path );
+        if (!module || !(tls_functions[i] = (void *)GetProcAddress( module, "gsbase_tls" )))
+        {
+            fprintf( stderr, "cannot load fixture %s, error %lu\n", path, GetLastError() );
+            ExitProcess(2);
+        }
+        check_teb();
+        check( tls_functions[i]( GetCurrentThreadId() ) == 0x1234abcd );
+    }
+}
+
+static void test_tls_growth( const char *dir )
+{
+    THREAD_BASIC_INFORMATION info;
+    HANDLE live, dead;
+    unsigned int i;
+
+    ready = CreateEventA( NULL, FALSE, FALSE, NULL );
+    resume = CreateEventA( NULL, FALSE, FALSE, NULL );
+    if (!ready || !resume) ExitProcess(2);
+    if (!(live = CreateThread( NULL, 0, tls_worker, NULL, 0, NULL ))) ExitProcess(2);
+    if (WaitForSingleObject( ready, 60000 ) != WAIT_OBJECT_0) ExitProcess(2);
+    load_tls_dlls( dir, 0, 48 );
+
+    /* Leave a terminated thread in Proton's TEB list while the next loads
+     * grow the TLS vectors again. Its pthread storage must no longer be used. */
+    if (!(dead = CreateThread( NULL, 0, victim, NULL, 0, NULL ))) ExitProcess(2);
+    if (WaitForSingleObject( ready, 60000 ) != WAIT_OBJECT_0) ExitProcess(2);
+    if (NtQueryInformationThread( dead, ThreadBasicInformation, &info, sizeof(info), NULL )) ExitProcess(2);
+    if (!TerminateThread( dead, 0 ) || WaitForSingleObject( dead, 60000 ) != WAIT_OBJECT_0) ExitProcess(2);
+    if (pthread_mode)
+    {
+        TEB *teb = info.TebBaseAddress;
+
+        /* The server can signal the thread handle before Unix teardown ends. */
+        for (i = 0; i < 10000 && *(void *volatile *)&teb->Instrumentation[0]; i++) Sleep(1);
+        check( !teb->Instrumentation[0] );
+    }
+    load_tls_dlls( dir, 48, ARRAY_SIZE(tls_functions) );
+    SetEvent( resume );
+    if (WaitForSingleObject( live, 60000 ) != WAIT_OBJECT_0) ExitProcess(2);
+    CloseHandle( live );
+    CloseHandle( dead );
+    CloseHandle( ready );
+    CloseHandle( resume );
+}
+
+int main( int argc, char **argv )
+{
+    HANDLE threads[8];
+    void *handler;
+    unsigned int round, i;
+
+    if (argc != 3 || (strcmp( argv[1], "on" ) && strcmp( argv[1], "off" )))
+    {
+        fprintf( stderr, "usage: gsbase-probe.exe on|off fixture-directory\n" );
+        return 2;
+    }
+    pthread_mode = !strcmp( argv[1], "on" );
+    tls_index = TlsAlloc();
+    if (tls_index == TLS_OUT_OF_INDEXES) return 2;
+    if (!(handler = AddVectoredExceptionHandler( 1, exception_handler ))) return 2;
+    check_teb();
+    test_tls_growth( argv[2] );
+    for (round = 0; round < 8; round++)
+    {
+        /* Existing and newly created threads must keep the startup selection. */
+        if (round == 4)
+            check( SetEnvironmentVariableA( "CX_ACTIVE_GRAPHICS_BACKEND", pthread_mode ? "dxvk" : "d3dmetal" ));
+        for (i = 0; i < ARRAY_SIZE(threads); i++)
+        {
+            threads[i] = CreateThread( NULL, 0, worker, NULL, 0, NULL );
+            if (!threads[i]) return 2;
+        }
+        if (WaitForMultipleObjects( ARRAY_SIZE(threads), threads, TRUE, 60000 ) != WAIT_OBJECT_0) return 2;
+        for (i = 0; i < ARRAY_SIZE(threads); i++) CloseHandle( threads[i] );
+        check_teb();
+    }
+    check( exceptions == 64 );
+    if (pthread_mode && NtCurrentTeb()->Instrumentation[0])
+    {
+        ULONG_PTR offset = -(ULONG_PTR)NtCurrentTeb()->Instrumentation[0];
+
+        expect_gs_fault = TRUE;
+        __asm__ volatile( ".byte 0x65,0x48,0x8b,0x00" : "+a" (offset) :: "memory" );
+        expect_gs_fault = FALSE;
+        check( gs_faults == 1 );
+        check_teb();
+    }
+    check( TlsFree( tls_index ) );
+    RemoveVectoredExceptionHandler( handler );
+    printf( "gsbase %s: %ld failures, %ld exceptions, %ld gs faults\n",
+            pthread_mode ? "on" : "off", failures, exceptions, gs_faults );
+    return failures ? 1 : 0;
+}
diff --git a/tools/gsbase-tls.c b/tools/gsbase-tls.c
new file mode 100644
index 00000000000..272b7a2cea3
--- /dev/null
+++ b/tools/gsbase-tls.c
@@ -0,0 +1,24 @@
+/* Static TLS fixture for gsbase-probe.c; see GSBASE-MODEL.md.
+ * Licensed under the GNU Lesser General Public License, version 2.1 or later.
+ */
+
+#include <windows.h>
+
+/* MinGW's CRT supplies the TLS directory and its .tls / .tls$ZZZ boundaries.
+ * Use a real PE TLS template, avoiding GCC's emulated __thread storage. */
+static DWORD initial_value __attribute__((section(".tls$AAA"), used)) = 0x1234abcd;
+extern const IMAGE_TLS_DIRECTORY64 _tls_used;
+extern DWORD _tls_index;
+
+__declspec(dllexport) DWORD WINAPI gsbase_tls( DWORD value )
+{
+    void **vector;
+    DWORD *slot, old;
+    ULONG_PTR offset = (ULONG_PTR)&initial_value - _tls_used.StartAddressOfRawData;
+
+    __asm__ volatile( "movq %%gs:0x58,%0" : "=r" (vector) );
+    slot = (DWORD *)((char *)vector[_tls_index] + offset);
+    old = *slot;
+    *slot = value;
+    return old;
+}
