     char                  syscall_dispatch; /* 0340 */
+#ifdef __APPLE__
+    BYTE                  pthread_gsbase; /* 0341 keep pthread TSD in %gs in PE code */
+#endif
 };
 
 C_ASSERT( sizeof(struct amd64_thread_data) <= sizeof(((struct ntdll_thread_data *)0)->cpu_data) );
@@ -529,6 +532,9 @@ C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct amd64_thread_data, ins
 C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct amd64_thread_data, fs ) == 0x338 );
 C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct amd64_thread_data, mxcsr ) == 0x33c );
 C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct amd64_thread_data, syscall_dispatch ) == 0x340 );
+#ifdef __APPLE__
+C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct amd64_thread_data, pthread_gsbase ) == 0x341 );
+#endif
 
 static inline struct amd64_thread_data *amd64_thread_data(void)
 {
@@ -933,7 +939,7 @@ static inline ucontext_t *init_handler( void *sigcontext )
 #elif defined __APPLE__
     {
         struct amd64_thread_data *thread_data = (struct amd64_thread_data *)&get_current_teb()->GdiTebBatch;
-        _thread_set_tsd_base( (uint64_t)thread_data->pthread_teb );
+        if (!use_macos_pthread_gsbase) _thread_set_tsd_base( (uint64_t)thread_data->pthread_teb );
 
         /* When in a syscall, CS will be the kernel's selector (0x07, SYSCALL_CS in xnu source)
          * instead of the user selector (cs64_sel: 0x2b, USER64_CS).
@@ -963,7 +969,7 @@ static inline void leave_handler( ucontext_t *sigcontext )
         if (fs32_sel) __asm__ volatile( "movw %0,%%fs" :: "r" (fs32_sel) );
     }
 #elif defined __APPLE__
-    if (!is_inside_signal_stack( (void *)RSP_sig(sigcontext )) &&
+    if (!use_macos_pthread_gsbase && !is_inside_signal_stack( (void *)RSP_sig(sigcontext )) &&
         !is_inside_syscall( RSP_sig(sigcontext )))
         _thread_set_tsd_base( (uint64_t)NtCurrentTeb() );
 #endif
@@ -1846,12 +1852,15 @@ __ASM_GLOBAL_FUNC( call_user_mode_callback,
                    "movw %ax,%fs\n"
                    "1:\n\t"
 #elif defined __APPLE__
+                   "cmpb $0,0x341(%r13)\n\t"   /* amd64_thread_data()->pthread_gsbase */
+                   "jne 1f\n\t"
                    "movq %rcx,%r10\n\t"
                    "movq %r13,%rdi\n\t"
                    "xorl %esi,%esi\n\t"
                    "movl $0x3000003,%eax\n\t"  /* _thread_set_tsd_base */
                    "syscall\n\t"
                    "movq %r10,%rcx\n\t"
+                   "1:\n\t"
 #endif
                    "movq 0x330(%r13),%r10\n\t" /* amd64_thread_data()->instrumentation_callback */
                    "movq (%r10),%r10\n\t"
@@ -2444,6 +2453,8 @@ static inline BOOL check_invalid_gsbase( ucontext_t *ucontext )
 #elif defined(__NetBSD__)
     sysarch( X86_64_GET_GSBASE, &cur_gsbase );
 #elif defined(__APPLE__)
+    /* A fault through the pthread TSD is not repaired by retrying with a TEB gsbase. */
+    if (use_macos_pthread_gsbase) return FALSE;
     /* init_handler() has already reset GSBASE, we can't determine what it was before the signal */
 #endif
 
@@ -2950,6 +2961,9 @@ NTSTATUS signal_alloc_thread( TEB *teb )
         else thread_data->fs = fs32_sel;
     }
     thread_data->frame_size = frame_size;
+#ifdef __APPLE__
+    thread_data->pthread_gsbase = use_macos_pthread_gsbase;
+#endif
     return STATUS_SUCCESS;
 }
 
@@ -3133,6 +3147,24 @@ void init_syscall_frame( LPTHREAD_START_ROUTINE entry, void *arg, BOOL suspend,
     sysarch( X86_64_SET_GSBASE, &teb );
 #elif defined (__APPLE__)
     thread_data->pthread_teb = mac_thread_gsbase();
+    if (use_macos_pthread_gsbase)
+    {
+        TEB *pthread_teb = thread_data->pthread_teb;
+
+        if (!pthread_teb)
+        {
+            ERR( "could not obtain the pthread TSD for D3DMetal\n" );
+            abort_thread(1);
+        }
+        /* CrossOver's macOS model: never move %gs away from pthread's TSD.
+         * Only these Windows fields can be overlaid on its reserved slots. */
+        pthread_teb->Tib.Self = teb->Tib.Self;
+        pthread_teb->ThreadLocalStoragePointer = teb->ThreadLocalStoragePointer;
+        pthread_teb->Peb = teb->Peb;
+        /* The PE loader and virtual_set_tls_information_teb() update this mirror. */
+        teb->Instrumentation[0] = pthread_teb;
+        TRACE_(seh)( "using pthread gsbase %p for teb %p\n", pthread_teb, teb );
+    }
 #else
 # error Please define setting %gs for your architecture
 #endif
