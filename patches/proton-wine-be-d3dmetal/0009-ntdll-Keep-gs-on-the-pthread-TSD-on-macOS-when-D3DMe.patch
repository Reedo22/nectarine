From 2ff0b1236767277d305acefec6a88f0a3cd9ce93 Mon Sep 17 00:00:00 2001
From: Nectarine <nectarine@localhost>
Date: Mon, 26 Oct 2026 16:31:20 -0400
Subject: [PATCH 09/11] ntdll: Keep %gs on the pthread TSD on macOS when
 D3DMetal is active.

Apple's D3DMetal PE DLLs call straight into libd3dshared.dylib on Windows threads, where macOS
libpthread reads its TSD through %gs. Our Wine points gsbase at the TEB in PE code, so the first
pthread call there faults (pthread_setname_np from D3DRMDispatch_Init). With
CX_ACTIVE_GRAPHICS_BACKEND=d3dmetal, use CrossOver's model instead: gsbase never moves; TEB Self,
ThreadLocalStoragePointer and Peb are mirrored into the TSD; TLS vector changes and TlsExpansionSlots
keep the mirror in sync (CrossOver 18756); the dispatchers reach the TEB through %gs:0x30, which works
in both modes, and skip every _thread_set_tsd_base swap. Without the variable nothing changes.
Mostly written by Codex (interrupted twice), reviewed and squashed.
---
 dlls/ntdll/loader.c             |  48 +++++++
 dlls/ntdll/unix/loader.c        |  17 ++-
 dlls/ntdll/unix/signal_x86_64.c |  71 ++++++++++-
 dlls/ntdll/unix/thread.c        |   3 +
 dlls/ntdll/unix/unix_private.h  |   5 +
 dlls/ntdll/unix/virtual.c       |  23 +++-
 tools/gsbase-probe.c            | 216 ++++++++++++++++++++++++++++++++
 tools/gsbase-tls.c              |  24 ++++
 8 files changed, 401 insertions(+), 6 deletions(-)
 create mode 100644 tools/gsbase-probe.c
 create mode 100644 tools/gsbase-tls.c

diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
index 27ad53376f2..19d21ba2341 100644
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -1734,6 +1734,36 @@ static NTSTATUS alloc_thread_tls(void)
     }
     ++tls_thread_count;
     NtCurrentTeb()->ThreadLocalStoragePointer = pointers;
+#if defined(__x86_64__) && !defined(__arm64ec__)
+    /* macOS pthread gsbase mode records the TSD mirror in Instrumentation[0]. */
+    if (NtCurrentTeb()->Instrumentation[0])
+        ((TEB *)NtCurrentTeb()->Instrumentation[0])->ThreadLocalStoragePointer = pointers;
+#endif
+    return STATUS_SUCCESS;
+}
+
+
+/*************************************************************************
+ *              alloc_thread_tls_expansion
+ *
+ * CrossOver 18756: native code may access dynamic TLS directly through %gs.
+ * Keep the expansion array at the same offset in the pthread TSD. Inline
+ * TlsSlots cannot be mirrored because they overlap pthread's own slots.
+ */
+static NTSTATUS alloc_thread_tls_expansion(void)
+{
+#if defined(__x86_64__) && !defined(__arm64ec__)
+    TEB *teb = NtCurrentTeb();
+
+    if (teb->Instrumentation[0] && !teb->WowTebOffset)
+    {
+        if (!teb->TlsExpansionSlots &&
+            !(teb->TlsExpansionSlots = RtlAllocateHeap( GetProcessHeap(), HEAP_ZERO_MEMORY,
+                                        8 * sizeof(teb->Peb->TlsExpansionBitmapBits) * sizeof(void *) )))
+            return STATUS_NO_MEMORY;
+        ((TEB *)teb->Instrumentation[0])->TlsExpansionSlots = teb->TlsExpansionSlots;
+    }
+#endif
     return STATUS_SUCCESS;
 }
 
@@ -4200,12 +4230,20 @@ void WINAPI LdrShutdownThread(void)
     if ((pointers = NtCurrentTeb()->ThreadLocalStoragePointer))
     {
         NtCurrentTeb()->ThreadLocalStoragePointer = NULL;
+#if defined(__x86_64__) && !defined(__arm64ec__)
+        if (NtCurrentTeb()->Instrumentation[0])
+            ((TEB *)NtCurrentTeb()->Instrumentation[0])->ThreadLocalStoragePointer = NULL;
+#endif
         --tls_thread_count;
         for (i = 0; i < tls_module_count; i++) free_tls_memory( pointers[i] );
         free_tls_memory( pointers );
     }
     RtlProcessFlsData( NtCurrentTeb()->FlsSlots, 2 );
     NtCurrentTeb()->FlsSlots = NULL;
+#if defined(__x86_64__) && !defined(__arm64ec__)
+    if (NtCurrentTeb()->Instrumentation[0] && !NtCurrentTeb()->WowTebOffset)
+        ((TEB *)NtCurrentTeb()->Instrumentation[0])->TlsExpansionSlots = NULL;
+#endif
     RtlFreeHeap( GetProcessHeap(), 0, NtCurrentTeb()->TlsExpansionSlots );
     NtCurrentTeb()->TlsExpansionSlots = NULL;
     RtlReleasePebLock();
@@ -4705,6 +4743,13 @@ void loader_init( CONTEXT *context, void **entry )
         /* TLS index 0 is always reserved, and wow64 reserves extra TLS entries */
         RtlSetBits( peb->TlsBitmap, 0, NtCurrentTeb()->WowTebOffset ? WOW64_TLS_MAX_NUMBER : 1 );
         RtlSetBits( peb->TlsBitmap, NTDLL_TLS_ERRNO, 1 );
+#if defined(__x86_64__) && !defined(__arm64ec__)
+        /* CrossOver 18756: force TlsAlloc() to use the mirrored expansion array. */
+        if (NtCurrentTeb()->Instrumentation[0] && !NtCurrentTeb()->WowTebOffset)
+            RtlSetBits( peb->TlsBitmap, 0, TLS_MINIMUM_AVAILABLE );
+#endif
+        if ((status = alloc_thread_tls_expansion()))
+            NtTerminateProcess( GetCurrentProcess(), status );
 
         if (!(tls_dirs = RtlAllocateHeap( GetProcessHeap(), HEAP_ZERO_MEMORY, tls_module_count * sizeof(*tls_dirs) )))
             NtTerminateProcess( GetCurrentProcess(), STATUS_NO_MEMORY );
@@ -4766,6 +4811,9 @@ void loader_init( CONTEXT *context, void **entry )
         arm64ec_thread_init();
 #endif
 
+        if ((status = alloc_thread_tls_expansion()))
+            NtTerminateThread( GetCurrentThread(), status );
+
         if (NtCurrentTeb()->SkipThreadAttach)
         {
             RtlLeaveCriticalSection( &loader_section );
diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index c7b903fc768..0b395be2b3a 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -134,6 +134,11 @@ const char **system_dll_paths = NULL;
 const char *user_name = NULL;
 SECTION_IMAGE_INFORMATION main_image_info = { NULL };
 
+#if defined(__APPLE__) && defined(__x86_64__)
+/* Selected once in __wine_main(), before any Wine thread enters PE code. */
+BOOL use_macos_pthread_gsbase;
+#endif
+
 /* die on a fatal error; use only during initialization */
 static void fatal_error( const char *err, ... )
 {
@@ -1325,13 +1330,12 @@ static BOOL sonoma_or_later(void)
 
 static void init_non_native_support(void)
 {
-    const char *backend = getenv( "CX_ACTIVE_GRAPHICS_BACKEND" );
     const char *libd3dshared_path = getenv( "CX_APPLEGPTK_LIBD3DSHARED_PATH" );
 
     register_non_native_code_region = NULL;
     supports_non_native_code_regions = NULL;
 
-    if (!backend || strcmp( backend, "d3dmetal" ) || !libd3dshared_path || !*libd3dshared_path ||
+    if (!use_macos_pthread_gsbase || !libd3dshared_path || !*libd3dshared_path ||
         !sonoma_or_later())
         return;
 
@@ -2883,6 +2887,15 @@ DECLSPEC_EXPORT void __wine_main( int argc, char *argv[] )
     main_argc = argc;
     main_argv = argv;
 
+#if defined(__APPLE__) && defined(__x86_64__)
+    {
+        const char *backend = getenv( "CX_ACTIVE_GRAPHICS_BACKEND" );
+
+        /* Select once, before creating any Wine threads or entering PE code. */
+        use_macos_pthread_gsbase = backend && !strcmp( backend, "d3dmetal" );
+    }
+#endif
+
     init_paths();
     if (!getenv( "WINELOADERNOEXEC" ) || argc <= 1) check_command_line( argc, argv );
     unsetenv( "WINELOADERNOEXEC" );
diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
