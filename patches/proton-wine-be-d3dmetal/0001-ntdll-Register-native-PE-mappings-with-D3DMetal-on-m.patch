From 3ff2a857f95c9e7e907d1132a8f8e0deea75845a Mon Sep 17 00:00:00 2001
From: Nectarine <nectarine@localhost>
Date: Sun, 25 Oct 2026 21:44:52 -0400
Subject: [PATCH 01/11] ntdll: Register native PE mappings with D3DMetal on
 macOS.

Port CrossOver 22434 so Rosetta can recognize non-native code regions. Require the explicit D3DMetal backend and dylib path, check optional symbols, and append the Unix call without renumbering Proton entries.
---
 dlls/ntdll/loader.c      |  9 ++++
 dlls/ntdll/unix/loader.c | 89 ++++++++++++++++++++++++++++++++++++++++
 dlls/ntdll/unixlib.h     |  9 ++++
 3 files changed, 107 insertions(+)

diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
index 16873540e95..27ad53376f2 100644
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -2476,6 +2476,15 @@ static NTSTATUS build_module( LPCWSTR load_path, const UNICODE_STRING *nt_name,
     TRACE_(loaddll)( "Loaded %s at %p: %s\n", debugstr_w(wm->ldr.FullDllName.Buffer), *module,
                      is_builtin ? "builtin" : "native" );
 
+#if defined(__x86_64__)
+    /* CrossOver 22434: the Unix side enables this only for D3DMetal on macOS. */
+    if (!is_builtin)
+    {
+        struct pe_module_loaded_params params = { *module, (BYTE *)*module + map_size };
+        WINE_UNIX_CALL( unix_pe_module_loaded, &params );
+    }
+#endif
+
     wm->ldr.LoadCount = 1;
     *pwm = wm;
     *module = NULL;
diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index 2361c0df6ae..c7b903fc768 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -72,6 +72,7 @@
 # include <mach/mach.h>
 # include <mach/mach_error.h>
 # include <mach-o/getsect.h>
+# include <sys/utsname.h>
 # include <crt_externs.h>
 # ifndef _POSIX_SPAWN_DISABLE_ASLR
 #  define _POSIX_SPAWN_DISABLE_ASLR 0x0100
@@ -1300,6 +1301,85 @@ const char * wine_debuginfostr_pc( void *pc )
     return __wine_dbg_strdup( buffer );
 }
 
+/* CrossOver 22434: register PE code with Rosetta through D3DMetal. */
+#if defined(__APPLE__) && defined(__x86_64__)
+static pthread_once_t non_native_init_once = PTHREAD_ONCE_INIT;
+static void *non_native_support_lib;
+void *libd3dshared_load_addr = NULL, *libd3dshared_code_end = NULL;
+static void (*register_non_native_code_region)( void*, void* );
+static bool (*supports_non_native_code_regions)(void);
+
+/* Non-native code region support requires Sonoma or later, don't bother loading on earlier OSes */
+static BOOL sonoma_or_later(void)
+{
+    int result;
+    struct utsname name;
+    unsigned major, minor;
+
+    result = (uname( &name ) == 0 &&
+              sscanf( name.release, "%u.%u", &major, &minor ) == 2 &&
+              major >= 23 /* macOS 14 Sonoma */);
+
+    return (result == 1) ? TRUE : FALSE;
+}
+
+static void init_non_native_support(void)
+{
+    const char *backend = getenv( "CX_ACTIVE_GRAPHICS_BACKEND" );
+    const char *libd3dshared_path = getenv( "CX_APPLEGPTK_LIBD3DSHARED_PATH" );
+
+    register_non_native_code_region = NULL;
+    supports_non_native_code_regions = NULL;
+
+    if (!backend || strcmp( backend, "d3dmetal" ) || !libd3dshared_path || !*libd3dshared_path ||
+        !sonoma_or_later())
+        return;
+
+    non_native_support_lib = dlopen( libd3dshared_path, RTLD_NOW | RTLD_LOCAL );
+    if (non_native_support_lib)
+    {
+        Dl_info dli;
+
+        register_non_native_code_region = dlsym( non_native_support_lib, "register_non_native_code_region" );
+        supports_non_native_code_regions = dlsym( non_native_support_lib, "supports_non_native_code_regions" );
+
+        if (supports_non_native_code_regions && dladdr( supports_non_native_code_regions, &dli ))
+        {
+            unsigned long code_size;
+            const BYTE *code = getsegmentdata( dli.dli_fbase, "__TEXT", &code_size );
+
+            if (code && code_size)
+            {
+                libd3dshared_load_addr = (void *)code;
+                libd3dshared_code_end = (BYTE *)code + code_size;
+            }
+        }
+
+        TRACE( "Loaded libd3dshared.dylib, does%s support non-native code regions\n",
+                supports_non_native_code_regions ? (supports_non_native_code_regions() ? "" : " not") : " not" );
+    }
+    else
+        TRACE( "Loading libd3dshared.dylib failed: %s\n", dlerror() );
+}
+
+static NTSTATUS pe_module_loaded( void *args )
+{
+    struct pe_module_loaded_params *params = args;
+
+    pthread_once( &non_native_init_once, &init_non_native_support );
+    if (register_non_native_code_region && supports_non_native_code_regions &&
+        supports_non_native_code_regions())
+    {
+        TRACE( "Marking non_native_code_region: %p-%p\n", params->start, params->end );
+        register_non_native_code_region( params->start, params->end );
+    }
+    return STATUS_SUCCESS;
+}
+#elif defined(__x86_64__)
+static NTSTATUS pe_module_loaded( void *args ) { return STATUS_NOT_IMPLEMENTED; }
+#endif
+
+
 static const unixlib_entry_t unix_call_funcs[] =
 {
     load_so_dll,
@@ -1316,6 +1396,9 @@ static const unixlib_entry_t unix_call_funcs[] =
     steamclient_setup_trampolines,
     debugstr_pc,
     unixcall_compat_wine_nt_to_unix_file_name,
+#if defined(__x86_64__)
+    pe_module_loaded,
+#endif
 };
 
 
@@ -1323,6 +1406,9 @@ static const unixlib_entry_t unix_call_funcs[] =
 
 static NTSTATUS wow64_load_so_dll( void *args ) { return STATUS_INVALID_IMAGE_FORMAT; }
 static NTSTATUS wow64_unwind_builtin_dll( void *args ) { return STATUS_UNSUCCESSFUL; }
+#if defined(__x86_64__)
+static NTSTATUS wow64_pe_module_loaded( void *args ) { return STATUS_NOT_IMPLEMENTED; }
+#endif
 
 static NTSTATUS wow64___wine_get_unix_env( void *args )
 {
@@ -1415,6 +1501,9 @@ const unixlib_entry_t unix_call_wow64_funcs[] =
     wow64_steamclient_setup_trampolines,
     wow64_debugstr_pc,
     wow64_compat_wine_nt_to_unix_file_name,
+#if defined(__x86_64__)
+    wow64_pe_module_loaded,
+#endif
 };
 
 #endif  /* _WIN64 */
diff --git a/dlls/ntdll/unixlib.h b/dlls/ntdll/unixlib.h
index 7621cef312a..d2b059f870d 100644
--- a/dlls/ntdll/unixlib.h
+++ b/dlls/ntdll/unixlib.h
@@ -108,6 +108,12 @@ struct compat_wine_nt_to_unix_file_name_params
     unsigned int disposition;
 };
 
+struct pe_module_loaded_params
+{
+    void *start;
+    void *end;
+};
+
 enum ntdll_unix_funcs
 {
     unix_load_so_dll,
@@ -124,6 +130,9 @@ enum ntdll_unix_funcs
     unix_steamclient_setup_trampolines,
     unix_debugstr_pc,
     unix_compat_wine_nt_to_unix_file_name,
+#if defined(__x86_64__)
+    unix_pe_module_loaded,
+#endif
 };
 
 extern unixlib_handle_t __wine_unixlib_handle;
-- 
